    1.156,                   !- Coefficient1 Constant
    -0.1816,                 !- Coefficient2 x
    0.0256,                  !- Coefficient3 x**2
    0.5,                     !- Minimum Value of x
    1.5;                     !- Maximum Value of x

  Curve:Biquadratic,
    <%= unitary_name %> Cool-Cap-fT2,  !- Name
