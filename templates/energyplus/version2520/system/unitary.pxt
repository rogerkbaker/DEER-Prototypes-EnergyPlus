    0,                       !- Coefficient3 x**2
    0,                       !- Minimum Value of x
    1;                       !- Maximum Value of x

  Curve:Quadratic,
    <%= unitary_name %> Cool-Cap-fFF1,  !- Name
    0.8,                     !- Coefficient1 Constant
