<% elsif (heat_coil_type == "DX-AIR" and dx_comp_speed_num > 1) %>
<% if (fan_config == "DRAW-THROUGH" and cool_coil_type == "NONE")
  iv_air_inlet_node_nm = unitary_name + " Unitary Inlet Node"
elsif (fan_config == "BLOW-THROUGH" and cool_coil_type == "NONE")
  iv_air_inlet_node_nm = unitary_name + " Supply Fan Outlet Node"
else
  iv_air_inlet_node_nm = unitary_name + " Cooling Coil Outlet Node"
end %>

<% if (fan_config == "BLOW-THROUGH" and aux_heat_coil_type == "NONE")
  iv_air_outlet_node_nm = unitary_name + " Unitary Outlet Node"
else
  iv_air_outlet_node_nm = unitary_name + " Heating Coil Outlet Node"
end %>

<% if (dx_comp_speed_num == 2)
  iv_rated_heat_cap = heat_coil_cap
else
  iv_rated_heat_cap = "Autosize"
end %>

<% if (dx_comp_speed_num < 3)
  iv_waste_heat_func_temp_curve_nm = unitary_name + " HP_Heat-Waste"
  iv_total_heat_cap3 = ""
  iv_rated_cop3 = ""
  iv_rated_airflow3 = ""
  iv_tot_heat_cap_temp_curve3_nm = ""
  iv_tot_heat_cap_flow_curve3_nm = ""
  iv_eir_temp_curve3_nm = ""
  iv_eir_flow_curve3_nm = ""
  iv_plf_curve3_nm = ""
  iv_waste_ht_frac_power3 = ""

else
  iv_waste_heat_func_temp_curve2_nm = unitary_name + " HP_Heat-Waste"
  iv_total_heat_cap3 = "Autosize"
  iv_rated_cop3 = heat_coil_cop_3
  iv_rated_airflow3 = "Autosize"
  iv_tot_heat_cap_temp_curve3_nm = unitary_name + " HP_Heat-Cap-fT3"
  iv_tot_heat_cap_flow_curve3_nm = unitary_name + " HP_Heat-Cap-fFF3"
  iv_eir_temp_curve3_nm = unitary_name + " HP_Heat-EIR-fT3"
  iv_eir_flow_curve3_nm = unitary_name + " HP_Heat-EIR-fFF3"
  iv_plf_curve3_nm = unitary_name + " HP_Heat-PLF-fPLR3"
  iv_waste_ht_frac_power3 = 0.2

 if (dx_comp_speed_num < 4)
  iv_waste_heat_func_temp_curve2_nm = unitary_name + " HP_Heat-Waste"
  iv_total_heat_cap4 = ""
  iv_rated_cop4 = ""
  iv_rated_airflow4 = ""
  iv_tot_heat_cap_temp_curve4_nm = ""
  iv_tot_heat_cap_flow_curve4_nm = ""
  iv_eir_temp_curve4_nm = ""
  iv_eir_flow_curve4_nm = ""
  iv_plf_curve4_nm = ""
  iv_waste_ht_frac_power4 = ""
  iv_waste_heat_func_temp_curve_nm = ""

 else
  iv_waste_heat_func_temp_curve3_nm = unitary_name + " HP_Heat-Waste"
  iv_total_heat_cap4 = heat_coil_cap
  iv_rated_cop4 = heat_coil_cop_4
  iv_rated_airflow4 = "Autosize"
  iv_tot_heat_cap_temp_curve4_nm = unitary_name + " HP_Heat-Cap-fT4"
  iv_tot_heat_cap_flow_curve4_nm = unitary_name + " HP_Heat-Cap-fFF4"
  iv_eir_temp_curve4_nm = unitary_name + " HP_Heat-EIR-fT4"
  iv_eir_flow_curve4_nm = unitary_name + " HP_Heat-EIR-fFF4"
  iv_plf_curve4_nm = unitary_name + " HP_Heat-PLF-fPLR4"
  iv_waste_ht_frac_power4 = 0.2
  iv_waste_heat_func_temp_curve4_nm = unitary_name + " HP_Heat-Waste"

 end
end %>

  Coil:Heating:DX:MultiSpeed,
    <%= unitary_name %> Heating Coil,  !- Name
    ,                        !- Availability Schedule Name
    <%= iv_air_inlet_node_nm %>,  !- Air Inlet Node Name
    <%= iv_air_outlet_node_nm %>,  !- Air Outlet Node Name
    <%= hp_min_temp %>,      !- Minimum Outdoor Dry-Bulb Temperature for Compressor Operation {C}
    ,                        !- Outdoor Dry-Bulb Temperature to Turn On Compressor {C}
    <%= dx_crankcase_cap %>, !- Crankcase Heater Capacity {W}
    ,                        !- Crankcase Heater Capacity Function of Temperature Curve Name
    <%= dx_crankcase_max_temp %>,  !- Maximum Outdoor Dry-Bulb Temperature for Crankcase Heater Operation {C}
    <%= unitary_name %> DefrostEIR,  !- Defrost Energy Input Ratio Function of Temperature Curve Name
    <%= hp_defrost_temp %>,  !- Maximum Outdoor Dry-Bulb Temperature for Defrost Operation {C}
    ReverseCycle,            !- Defrost Strategy
    Timed,                   !- Defrost Control
    0.0,                     !- Defrost Time Period Fraction
    ,                        !- Resistive Defrost Heater Capacity {W}
    No,                      !- Apply Part Load Fraction to Speeds Greater than 1
    Electricity,             !- Fuel Type
    ,                        !- Region number for Calculating HSPF
    <%= dx_comp_speed_num %>,!- Number of Speeds
    Autosize,                !- Speed 1 Gross Rated Heating Capacity {W}
    <%= heat_coil_cop_1 %>,  !- Speed 1 Gross Rated Heating COP {W/W}
    <%= fan_flow %>,         !- Speed 1 Rated Air Flow Rate {m3/s}
    ,                        !- 2017 Speed 1 Rated Supply Air Fan Power Per Volume Flow Rate {W/(m3/s)}
    ,                        !- 2023 Speed 1 Rated Supply Air Fan Power Per Volume Flow Rate {W/(m3/s)}
    <%= unitary_name %> HP_Heat-Cap-fT1,  !- Speed 1 Heating Capacity Function of Temperature Curve Name
    <%= unitary_name %> HP_Heat-Cap-fFF1,  !- Speed 1 Heating Capacity Function of Flow Fraction Curve Name
    <%= unitary_name %> HP_Heat-EIR-fT1,  !- Speed 1 Energy Input Ratio Function of Temperature Curve Name
    <%= unitary_name %> HP_Heat-EIR-fFF1,  !- Speed 1 Energy Input Ratio Function of Flow Fraction Curve Name
    <%= unitary_name %> HP_Heat-PLF-fPLR1,  !- Speed 1 Part Load Fraction Correlation Curve Name
    0.2,                     !- Speed 1 Rated Waste Heat Fraction of Power Input {dimensionless}
    <%= unitary_name %> HP_Heat-Waste,  !- Speed 1 Waste Heat Function of Temperature Curve Name
    <%= iv_rated_heat_cap %>,!- Speed 2 Gross Rated Heating Capacity {W}
    <%= heat_coil_cop_2 %>,  !- Speed 2 Gross Rated Heating COP {W/W}
    Autosize,                !- Speed 2 Rated Air Flow Rate {m3/s}
    ,                        !- 2017 Speed 2 Rated Supply Air Fan Power Per Volume Flow Rate {W/(m3/s)}
    ,                        !- 2023 Speed 2 Rated Supply Air Fan Power Per Volume Flow Rate {W/(m3/s)}
    <%= unitary_name %> HP_Heat-Cap-fT2,  !- Speed 2 Heating Capacity Function of Temperature Curve Name
    <%= unitary_name %> HP_Heat-Cap-fFF2,  !- Speed 2 Heating Capacity Function of Flow Fraction Curve Name
    <%= unitary_name %> HP_Heat-EIR-fT2,  !- Speed 2 Energy Input Ratio Function of Temperature Curve Name
    <%= unitary_name %> HP_Heat-EIR-fFF2,  !- Speed 2 Energy Input Ratio Function of Flow Fraction Curve Name
    <%= unitary_name %> HP_Heat-PLF-fPLR2,  !- Speed 2 Part Load Fraction Correlation Curve Name
    0.2,                     !- Speed 2 Rated Waste Heat Fraction of Power Input {dimensionless}
    <%= iv_waste_heat_func_temp_curve2_nm %>,  !- Speed 2 Waste Heat Function of Temperature Curve Name
    <%= iv_total_heat_cap3 %>,  !- Speed 3 Gross Rated Heating Capacity {W}
    <%= iv_rated_cop3 %>,    !- Speed 3 Gross Rated Heating COP {W/W}
    <%= iv_rated_airflow3 %>,!- Speed 3 Rated Air Flow Rate {m3/s}
    ,                        !- 2017 Speed 3 Rated Supply Air Fan Power Per Volume Flow Rate {W/(m3/s)}
    ,                        !- 2023 Speed 3 Rated Supply Air Fan Power Per Volume Flow Rate {W/(m3/s)}
    <%= iv_tot_heat_cap_temp_curve3_nm %>,  !- Speed 3 Heating Capacity Function of Temperature Curve Name
    <%= iv_tot_heat_cap_flow_curve3_nm %>,  !- Speed 3 Heating Capacity Function of Flow Fraction Curve Name
    <%= iv_eir_temp_curve3_nm %>,  !- Speed 3 Energy Input Ratio Function of Temperature Curve Name
    <%= iv_eir_flow_curve3_nm %>,  !- Speed 3 Energy Input Ratio Function of Flow Fraction Curve Name
    <%= iv_plf_curve3_nm %>, !- Speed 3 Part Load Fraction Correlation Curve Name
    <%= iv_waste_ht_frac_power3 %>,  !- Speed 3 Rated Waste Heat Fraction of Power Input {dimensionless}
    <%= iv_waste_heat_func_temp_curve3_nm %>,  !- Speed 3 Waste Heat Function of Temperature Curve Name
    <%= iv_total_heat_cap4 %>,  !- Speed 4 Gross Rated Heating Capacity {W}
    <%= iv_rated_cop4 %>,    !- Speed 4 Gross Rated Heating COP {W/W}
    <%= iv_rated_airflow4 %>,!- Speed 4 Rated Air Flow Rate {m3/s}
    ,                        !- 2017 Speed 4 Rated Supply Air Fan Power Per Volume Flow Rate {W/(m3/s)}
    ,                        !- 2023 Speed 4 Rated Supply Air Fan Power Per Volume Flow Rate {W/(m3/s)}
    <%= iv_tot_heat_cap_temp_curve4_nm %>,  !- Speed 4 Heating Capacity Function of Temperature Curve Name
    <%= iv_tot_heat_cap_flow_curve4_nm %>,  !- Speed 4 Heating Capacity Function of Flow Fraction Curve Name
    <%= iv_eir_temp_curve4_nm %>,  !- Speed 4 Energy Input Ratio Function of Temperature Curve Name
    <%= iv_eir_flow_curve4_nm %>,  !- Speed 4 Energy Input Ratio Function of Flow Fraction Curve Name
    <%= iv_plf_curve4_nm %>, !- Speed 4 Part Load Fraction Correlation Curve Name
    <%= iv_waste_ht_frac_power4 %>,  !- Speed 4 Rated Waste Heat Fraction of Power Input {dimensionless}
    <%= iv_waste_heat_func_temp_curve4_nm %>;  !- Speed 4 Waste Heat Function of Temperature Curve Name

