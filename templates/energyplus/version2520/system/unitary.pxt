 else
  iv_air_outlet_node_nm = unitary_name + " Unitary Outlet Node"
  iv_temp_setpt_node_nm = ""
 end
else
 if (control_type == "Setpoint" and not doas)
  iv_air_outlet_node_nm = unitary_name + " Heating Coil Outlet Node"
  iv_temp_setpt_node_nm = unitary_name + " Heating Coil Outlet Node"
 else
  iv_air_outlet_node_nm = unitary_name + " Heating Coil Outlet Node"
  iv_temp_setpt_node_nm = ""
 end
end %>

  Coil:Heating:Electric,
    <%= unitary_name %> Heating Coil,  !- Name
    ,                        !- Availability Schedule Name
    <%= heat_coil_eff %>,    !- Efficiency
    <%= heat_coil_cap %>,    !- Nominal Capacity {W}
    <%= iv_air_inlet_node_nm %>,  !- Air Inlet Node Name
    <%= iv_air_outlet_node_nm %>,  !- Air Outlet Node Name
    <%= iv_temp_setpt_node_nm %>;  !- Temperature Setpoint Node Name

<% elsif (heat_coil_type == "DX-AIR" and dx_comp_speed_num == 1) %>

<% if (fan_config == "DRAW-THROUGH" and cool_coil_type == "NONE")
  iv_air_inlet_node_nm = unitary_name + " Unitary Inlet Node"
elsif (fan_config == "BLOW-THROUGH" and cool_coil_type == "NONE")
