end %>

<% if (dx_comp_speed_num == 2)
  iv_spd2_cool_cap = cool_coil_cap
else
  iv_spd2_cool_cap = "Autosize"
end %>

<% if (cool_coil_type == "DX-AIR")
  iv_spd2_evap_cond_eff = ""
  iv_spd2_evap_cond_airflow_rate = ""
elsif (cool_coil_type == "DX-EVAP")
  iv_spd2_evap_cond_eff = cool_coil_evap_eff
  iv_spd2_evap_cond_airflow_rate = "Autosize"
end %>

<% if (dx_comp_speed_num < 3)
  iv_spd3_tot_cool_cap = ""
  iv_spd3_gross_shr = ""
  iv_spd3_cop = ""
  iv_spd3_rated_airflow_rate = ""
  iv_spd3_cool_cap_vs_temp_curve_nm = ""
  iv_spd3_cool_cap_vs_flow_curve_nm = ""
  iv_spd3_eir_vs_temp_curve_nm = ""
  iv_spd3_eir_vs_flow_curve_nm = ""
  iv_spd3_plf_curve_nm = ""
  iv_spd3_time_cond_removal_begin = ""
  iv_spd3_ratio_evap_rate = ""
  iv_spd3_max_cyc_rate = ""
  iv_spd3_latent_cap_time_const = ""
  iv_spd3_waste_heat_frac_of_pwr = ""
  iv_spd3_waste_heat_vs_temp_curve_nm = ""
  iv_spd3_evap_cond_eff = ""
  iv_spd3_evap_cond_airflow_rate = ""
else
  iv_spd3_tot_cool_cap = "Autosize"
  iv_spd3_gross_shr = "Autosize"
  iv_spd3_cop = cool_coil_cop_3
  iv_spd3_rated_airflow_rate = "Autosize"
  iv_spd3_cool_cap_vs_temp_curve_nm = unitary_name + " Cool-Cap-fT3"
  iv_spd3_cool_cap_vs_flow_curve_nm = unitary_name + " Cool-Cap-fFF3"
  iv_spd3_eir_vs_temp_curve_nm = unitary_name + " Cool-EIR-fT3"
  iv_spd3_eir_vs_flow_curve_nm = unitary_name + " Cool-EIR-fFF3"
  iv_spd3_plf_curve_nm = unitary_name + " Cool-PLF-fPLR3"
  iv_spd3_time_cond_removal_begin = 1000
  iv_spd3_ratio_evap_rate = 1.5
  iv_spd3_max_cyc_rate = 3
  iv_spd3_latent_cap_time_const = 45
  iv_spd3_waste_heat_frac_of_pwr = 0.2
  iv_spd3_waste_heat_vs_temp_curve_nm = unitary_name + " Cool-Waste"
 if (cool_coil_type == "DX-AIR")
  iv_spd3_evap_cond_eff = ""
  iv_spd3_evap_cond_airflow_rate = ""
 elsif (cool_coil_type == "DX-EVAP")
  iv_spd3_evap_cond_eff = cool_coil_evap_eff
  iv_spd3_evap_cond_airflow_rate = "Autosize"
 end %>

 <% if (dx_comp_speed_num < 4)
  iv_spd4_tot_cool_cap = ""
  iv_spd4_gross_shr = ""
  iv_spd4_cop = ""
  iv_spd4_rated_airflow_rt = ""
  iv_spd4_cool_cap_vs_temp_curve_nm = ""
  iv_spd4_cool_cap_vs_flow_cirve_nm = ""
  iv_spd4_eir_vs_temp_curve_nm = ""
  iv_spd4_eir_vs_flow_curve_nm = ""
  iv_spd4_plf_curve_nm = ""
  iv_spd4_nom_time_cond_removal = ""
  iv_spd4_ratio_moisture_evap_rate = ""
  iv_spd4_max_cycling_rate = ""
  iv_spd4_latent_cap_time_const = ""
  iv_spd4_waste_heat_frac_power = ""
  iv_spd4_waste_heat_vs_temp_curve_nm = ""
  iv_spd4_evap_cond_eff = ""
  iv_spd4_evap_cond_af_rate = ""
 else
  iv_spd4_tot_cool_cap = cool_coil_cap
  iv_spd4_gross_shr = "Autosize"
  iv_spd4_cop = cool_coil_cop_4
  iv_spd4_rated_airflow_rt = "Autosize"
  iv_spd4_cool_cap_vs_temp_curve_nm = unitary_name + " Cool-Cap-fT4"
  iv_spd4_cool_cap_vs_flow_cirve_nm = unitary_name + " Cool-Cap-fFF4"
  iv_spd4_eir_vs_temp_curve_nm = unitary_name + " Cool-EIR-fT4"
  iv_spd4_eir_vs_flow_curve_nm = unitary_name + " Cool-EIR-fFF4"
  iv_spd4_plf_curve_nm = unitary_name + " Cool-PLF-fPLR4"
  iv_spd4_nom_time_cond_removal = 1000
  iv_spd4_ratio_moisture_evap_rate = 1.5
  iv_spd4_max_cycling_rate = 3
  iv_spd4_latent_cap_time_const = 45
  iv_spd4_waste_heat_frac_power = 0.2
  iv_spd4_waste_heat_vs_temp_curve_nm = unitary_name + " Cool-Waste"
  if (cool_coil_type == "DX-AIR")
   iv_spd4_evap_cond_eff = ""
   iv_spd4_evap_cond_af_rate = ""
  elsif (cool_coil_type == "DX-EVAP")
   iv_spd4_evap_cond_eff = cool_coil_evap_eff
   iv_spd4_evap_cond_af_rate = "Autosize"
  end
 end
end %>

  Coil:Cooling:DX:MultiSpeed,
    <%= unitary_name %> Cooling Coil,  !- Name
    ,                        !- Availability Schedule Name
    <%= iv_air_inlet_node_nm %>,  !- Air Inlet Node Name
    <%= iv_air_outlet_node_nm %>,  !- Air Outlet Node Name
    ,                        !- Condenser Air Inlet Node Name
    <%= iv_cond_type %>,     !- Condenser Type
    -25.0,                   !- Minimum Outdoor Dry-Bulb Temperature for Compressor Operation {C}
    ,                        !- Supply Water Storage Tank Name
    <%= clear_water_storage_tank %>,  !- Condensate Collection Water Storage Tank Name
    No,                      !- Apply Part Load Fraction to Speeds Greater than 1
    No,                      !- Apply Latent Degradation to Speeds Greater than 1
    <%= dx_crankcase_cap %>, !- Crankcase Heater Capacity {W}
    ,                        !- Crankcase Heater Capacity Function of Temperature Curve Name
    <%= dx_crankcase_max_temp %>,  !- Maximum Outdoor Dry-Bulb Temperature for Crankcase Heater Operation {C}
    ,                        !- Basin Heater Capacity {W/K}
    ,                        !- Basin Heater Setpoint Temperature {C}
    ,                        !- Basin Heater Operating Schedule Name
    Electricity,             !- Fuel Type
    <%= dx_comp_speed_num %>,!- Number of Speeds
    Autosize,                !- Speed 1 Gross Rated Total Cooling Capacity {W}
    Autosize,                !- Speed 1 Gross Rated Sensible Heat Ratio
    <%= cool_coil_cop_1 %>,  !- Speed 1 Gross Rated Cooling COP {W/W}
    <%= fan_flow %>,         !- Speed 1 Rated Air Flow Rate {m3/s}
    ,                        !- 2017 Speed 1 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m3/s)}
    ,                        !- 2023 Speed 1 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m3/s)}
    <%= unitary_name %> Cool-Cap-fT1,  !- Speed 1 Total Cooling Capacity Function of Temperature Curve Name
    <%= unitary_name %> Cool-Cap-fFF1,  !- Speed 1 Total Cooling Capacity Function of Flow Fraction Curve Name
    <%= unitary_name %> Cool-EIR-fT1,  !- Speed 1 Energy Input Ratio Function of Temperature Curve Name
    <%= unitary_name %> Cool-EIR-fFF1,  !- Speed 1 Energy Input Ratio Function of Flow Fraction Curve Name
    <%= unitary_name %> Cool-PLF-fPLR1,  !- Speed 1 Part Load Fraction Correlation Curve Name
    1000,                    !- Speed 1 Nominal Time for Condensate Removal to Begin {s}
    1.5,                     !- Speed 1 Ratio of Initial Moisture Evaporation Rate and Steady State Latent Capacity {dimensionless}
    3,                       !- Speed 1 Maximum Cycling Rate {cycles/hr}
    45,                      !- Speed 1 Latent Capacity Time Constant {s}
    0.2,                     !- Speed 1 Rated Waste Heat Fraction of Power Input {dimensionless}
    <%= unitary_name %> Cool-Waste,  !- Speed 1 Waste Heat Function of Temperature Curve Name
    <%= iv_spd1_evap_cond_eff %>,  !- Speed 1 Evaporative Condenser Effectiveness {dimensionless}
    <%= iv_spd1_evap_cond_airflow_rate %>,  !- Speed 1 Evaporative Condenser Air Flow Rate {m3/s}
    ,                        !- Speed 1 Rated Evaporative Condenser Pump Power Consumption {W}
    <%= iv_spd2_cool_cap %>, !- Speed 2 Gross Rated Total Cooling Capacity {W}
    Autosize,                !- Speed 2 Gross Rated Sensible Heat Ratio
    <%= cool_coil_cop_2 %>,  !- Speed 2 Gross Rated Cooling COP {W/W}
    Autosize,                !- Speed 2 Rated Air Flow Rate {m3/s}
    ,                        !- 2017 Speed 2 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m3/s)}
    ,                        !- 2023 Speed 2 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m3/s)}
    <%= unitary_name %> Cool-Cap-fT2,  !- Speed 2 Total Cooling Capacity Function of Temperature Curve Name
    <%= unitary_name %> Cool-Cap-fFF2,  !- Speed 2 Total Cooling Capacity Function of Flow Fraction Curve Name
    <%= unitary_name %> Cool-EIR-fT2,  !- Speed 2 Energy Input Ratio Function of Temperature Curve Name
    <%= unitary_name %> Cool-EIR-fFF2,  !- Speed 2 Energy Input Ratio Function of Flow Fraction Curve Name
    <%= unitary_name %> Cool-PLF-fPLR2,  !- Speed 2 Part Load Fraction Correlation Curve Name
    1000,                    !- Speed 2 Nominal Time for Condensate Removal to Begin {s}
    1.5,                     !- Speed 2 Ratio of Initial Moisture Evaporation Rate and steady state Latent Capacity {dimensionless}
    3,                       !- Speed 2 Maximum Cycling Rate {cycles/hr}
    45,                      !- Speed 2 Latent Capacity Time Constant {s}
    0.2,                     !- Speed 2 Rated Waste Heat Fraction of Power Input {dimensionless}
    <%= unitary_name %> Cool-Waste,  !- Speed 2 Waste Heat Function of Temperature Curve Name
    <%= iv_spd2_evap_cond_eff %>,  !- Speed 2 Evaporative Condenser Effectiveness {dimensionless}
    <%= iv_spd2_evap_cond_airflow_rate %>,  !- Speed 2 Evaporative Condenser Air Flow Rate {m3/s}
    ,                        !- Speed 2 Rated Evaporative Condenser Pump Power Consumption {W}
    <%= iv_spd3_tot_cool_cap %>,  !- Speed 3 Gross Rated Total Cooling Capacity {W}
    <%= iv_spd3_gross_shr %>,!- Speed 3 Gross Rated Sensible Heat Ratio
    <%= iv_spd3_cop %>,      !- Speed 3 Gross Rated Cooling COP {W/W}
    <%= iv_spd3_rated_airflow_rate %>,  !- Speed 3 Rated Air Flow Rate {m3/s}
    ,                        !- 2017 Speed 3 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m3/s)}
    ,                        !- 2023 Speed 3 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m3/s)}
    <%= iv_spd3_cool_cap_vs_temp_curve_nm %>,  !- Speed 3 Total Cooling Capacity Function of Temperature Curve Name
    <%= iv_spd3_cool_cap_vs_flow_curve_nm %>,  !- Speed 3 Total Cooling Capacity Function of Flow Fraction Curve Name
    <%= iv_spd3_eir_vs_temp_curve_nm %>,  !- Speed 3 Energy Input Ratio Function of Temperature Curve Name
    <%= iv_spd3_eir_vs_flow_curve_nm %>,  !- Speed 3 Energy Input Ratio Function of Flow Fraction Curve Name
    <%= iv_spd3_plf_curve_nm %>,  !- Speed 3 Part Load Fraction Correlation Curve Name
    <%= iv_spd3_time_cond_removal_begin %>,  !- Speed 3 Nominal Time for Condensate Removal to Begin {s}
    <%= iv_spd3_ratio_evap_rate %>,  !- Speed 3 Ratio of Initial Moisture Evaporation Rate and steady state Latent Capacity {dimensionless}
    <%= iv_spd3_max_cyc_rate %>,  !- Speed 3 Maximum Cycling Rate {cycles/hr}
    <%= iv_spd3_latent_cap_time_const %>,  !- Speed 3 Latent Capacity Time Constant {s}
    <%= iv_spd3_waste_heat_frac_of_pwr %>,  !- Speed 3 Rated Waste Heat Fraction of Power Input {dimensionless}
    <%= iv_spd3_waste_heat_vs_temp_curve_nm %>,  !- Speed 3 Waste Heat Function of Temperature Curve Name
    <%= iv_spd3_evap_cond_eff %>,  !- Speed 3 Evaporative Condenser Effectiveness {dimensionless}
    <%= iv_spd3_evap_cond_airflow_rate %>,  !- Speed 3 Evaporative Condenser Air Flow Rate {m3/s}
    ,                        !- Speed 3 Rated Evaporative Condenser Pump Power Consumption {W}
    <%= iv_spd4_tot_cool_cap %>,  !- Speed 4 Gross Rated Total Cooling Capacity {W}
    <%= iv_spd4_gross_shr %>,!- Speed 4 Gross Rated Sensible Heat Ratio
    <%= iv_spd4_cop %>,      !- Speed 4 Gross Rated Cooling COP {W/W}
    <%= iv_spd4_rated_airflow_rt %>,  !- Speed 4 Rated Air Flow Rate {m3/s}
    ,                        !- 2017 Speed 4 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m3/s)}
    ,                        !- 2023 Speed 4 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m3/s)}
    <%= iv_spd4_cool_cap_vs_temp_curve_nm %>,  !- Speed 4 Total Cooling Capacity Function of Temperature Curve Name
    <%= iv_spd4_cool_cap_vs_flow_cirve_nm %>,  !- Speed 4 Total Cooling Capacity Function of Flow Fraction Curve Name
    <%= iv_spd4_eir_vs_temp_curve_nm %>,  !- Speed 4 Energy Input Ratio Function of Temperature Curve Name
    <%= iv_spd4_eir_vs_flow_curve_nm %>,  !- Speed 4 Energy Input Ratio Function of Flow Fraction Curve Name
    <%= iv_spd4_plf_curve_nm %>,  !- Speed 4 Part Load Fraction Correlation Curve Name
    <%= iv_spd4_nom_time_cond_removal %>,  !- Speed 4 Nominal Time for Condensate Removal to Begin {s}
    <%= iv_spd4_ratio_moisture_evap_rate %>,  !- Speed 4 Ratio of Initial Moisture Evaporation Rate and steady state Latent Capacity {dimensionless}
    <%= iv_spd4_max_cycling_rate %>,  !- Speed 4 Maximum Cycling Rate {cycles/hr}
    <%= iv_spd4_latent_cap_time_const %>,  !- Speed 4 Latent Capacity Time Constant {s}
    <%= iv_spd4_waste_heat_frac_power %>,  !- Speed 4 Rated Waste Heat Fraction of Power Input {dimensionless}
    <%= iv_spd4_waste_heat_vs_temp_curve_nm %>,  !- Speed 4 Waste Heat Function of Temperature Curve Name
    <%= iv_spd4_evap_cond_eff %>,  !- Speed 4 Evaporative Condenser Effectiveness {dimensionless}
    <%= iv_spd4_evap_cond_af_rate %>,  !- Speed 4 Evaporative Condenser Air Flow Rate {m3/s}
    ;                        !- Speed 4 Rated Evaporative Condenser Pump Power Consumption {W}

<% if (dx_comp_speed_num == 2) %>
  <% if dx_type == "PNNL" %>
! Following performance curves taken from multi-speed DX PNNL model 90.1-2004 (RetailStandAlone and possibly others)

  Curve:Biquadratic,
    <%= unitary_name %> Cool-Cap-fT1,  !- Name
    0.766956,                !- Coefficient1 Constant
    0.0107756,               !- Coefficient2 x
    -4.14703e-05,            !- Coefficient3 x**2
    0.00134961,              !- Coefficient4 y
    -0.000261144,            !- Coefficient5 y**2
    0.000457488,             !- Coefficient6 x*y
    12.77778,                !- Minimum Value of x
    23.88889,                !- Maximum Value of x
    21.11111,                !- Minimum Value of y
    46.11111;                !- Maximum Value of y

  Curve:Biquadratic,
    <%= unitary_name %> Cool-EIR-fT1,  !- Name
    0.297145,                !- Coefficient1 Constant
    0.0430933,               !- Coefficient2 x
    -0.000748766,            !- Coefficient3 x**2
    0.00597727,              !- Coefficient4 y
    0.000482112,             !- Coefficient5 y**2
    -0.000956448,            !- Coefficient6 x*y
    12.77778,                !- Minimum Value of x
    23.88889,                !- Maximum Value of x
    21.11111,                !- Minimum Value of y
    46.11111;                !- Maximum Value of y

