Version, 22.2;
!x!<%#INITIALIZE
!x!require "modelkit/energyplus"
!x!
!x!parameter "ahu_name"
!x!parameter "branch_names"
!x!
!x!parameter "ahu_type", :name => "AHU Type", :description => "Type of air handling unit",
!x!  :default => "CAV", :domain => String  # ["CAV", "VAV", "DOAS", "MAU"]
!x!
!x!parameter "duct_type", :default => "SINGLE"  # (SINGLE | DUAL) Sets AHU distribution system to single-duct or dual duct
!x!
!x!import "system/unitary.pxt", :group => "unitary" do
!x!  include "*"
!x!  exclude "unitary_name|doas|sat_temp_max"
!x!  parameter "fan_subcat", :default => "AHU Fans"
!x!end
!x!
!x!parameter "fan_return", :default => false  # Creates return fan for AHU system
!x!parameter "fan_return_rise", :default => 2.25['in H2O']  # Pressure rise across return fan.
!x!
!x!# rename design_ => sizing_
!x!
!x!parameter "design_peak_load", :default => "NONCOINCIDENT"  # (NONCOINCIDENT | COINCIDENT) Zone peak load sum method used in Sizing:System object. NonCoincident is generally more conservative and over-sizes
!x!parameter "design_max_heat_frac", :default => Autosize  # Ratio of max system heating air flow to max system air flow
!x!  # Value for VAV depends on heating configuration and terminal damper position, 1 for all other system types
!x!
!x!parameter "oa_sch", :name => "Outdoor Air Schedule", :description => "Outdoor air schedule controls when ventilation air is supplied",
!x!  :default => "Through: 12/31,\n  For: AllDays,\n  Until: 24:00, 1;", :domain => String
!x!parameter "oa_frac_sch", :name => "Outdoor Air Schedule", :description => "Outdoor air schedule controls when ventilation air is supplied",
!x!  :default => "NONE"
!x!parameter "oa_frac_max_sch", :name => "Outdoor Air Schedule", :description => "Outdoor air schedule controls when ventilation air is supplied",
!x!  :default => "NONE"
!x!
!x!parameter "zone_max_oa_frac", :default => 1
!x!parameter "oa_min_flow", :default => Autosize  # Minimum design outdoor air flow rate {m3/s}
!x!parameter "oa_max_flow", :default => Autosize  # Maximum design outdoor air flow rate {m3/s}
!x!# or should be:?  oa_flow_min, oa_flow_max
!x!
!x!# needed?  there's nothing else that allows you to set the minimum fraction of the max
!x!parameter "oa_frac", :default => 0.3  # Sets AHU design OA fraction. Value of 1.0 indicates DOAS system
!x!
!x!# maybe: oa_min_flow_frac   or  oa_flow_min_frac
!x!
!x!parameter "night_cycle_control_type", :default=>"CYCLE-AHU-FOR-ANY-ZONE" # (NONE | FOLLOW-FAN-SCHEDULE | CYCLE-AHU-FOR-ANY-ZONE | CYCLE-AHU-FOR-CONTROL-ZONE-ONLY | CYCLE-ZONE-FANS-ONLY) Control type used in night cycle availability manager. DOAS systems should use "CYCLE-ZONE-FANS-ONLY"
!x!
!x!parameter "oa_econ_type", :default => "NONE"  # (NONE | FIXED-DRY-BULB | DIFFERENTIAL-DRY-BULB | FIXED-ENTHALPY | DIFFERENTIAL-ENTHALPY | ELECTRONIC-ENTHALPY | FIXED-DEW-POINT-AND-DRY-BULB | DIFFERENTIAL-DRY-BULB-AND-ENTHALPY) Economizer control type
!x!parameter "oa_econ_mode", :default => "MODULATE-FLOW" # ( MODULATE-FLOW | MINIMUM-FLOW-WITH-BYPASS ) ModulateFlow = OA flow increased to meet mixed air setpoint, MinimumFlowWithBypass = forces OA flow to remain at minimum
!x!parameter "oa_econ_min_temp", :default => 40['F']  # Minimum outdoor air temperature for economizer operation
!x!parameter "oa_econ_max_temp", :default => 75['F']  # Maximum outdoor air temperature for economizer operation (depends on climate zone per ASHRAE 90.1 Table G3.1.2.8)
!x!parameter "oa_econ_lockout", :default => "LockoutWithHeating"  # (NoLockout | LockoutWithHeating | LockoutWithCompressor)
!x!
!x!parameter "oa_energy_recovery", :default => false # Turn on OA energy recovery. Look up ASHRAE 90.1 Tables 6.5.6.1-1 & 6.5.6.1-2 for allowable scenarios
!x!parameter "oa_er_sensible_eff", :default => 0.7 # Sensible effectiveness of OA energy recovery HX. Minimum value from ASHRAE 90.1 Section 6.5.6.1
!x!parameter "oa_er_latent_eff", :default => 0.6 # Latent effectiveness of OA energy recovery HX. Minimum value from ASHRAE 90.1 Section 6.5.6.1
!x!parameter "oa_energy_recovery_power", :default=>260['W'] # Nominal electric power
!x!
!x!parameter "oa_indirect_evap", :default => false # Turns on indirect evaporative cooling of OA stream before entering OA mixer
!x!parameter "oa_ind_evap_eff", :default => 1.0
!x!parameter "oa_ind_evap_wb_eff", :default => 1.0 # Indirect evap cooler wetbulb design effectiveness
!x!parameter "oa_ind_evap_db_eff", :default => 1.0 # Indirect evap cooler drybulb design effectiveness
!x!parameter "oa_ind_evap_pump_factor", :default => 90 # W/(m3/s), used to autosize recirculating water pump (E+ default)
!x!parameter "oa_ind_evap_fan_factor", :default => 250 # W/(m3/s), used to autosize secondary air fan (E+ default)
!x!parameter "oa_ind_evap_secondary", :default => "RETURN" # (RETURN | OUTDOORS)
!x!
!x!parameter "oa_solar_preheat", :default => false # Turns on OA solar preheat capability via collector surfaces
!x!parameter "oa_solar_surfaces", :default => [] # Array of surface names that will be solar collectors for OA solar preheat
!x!parameter "oa_solar_control_zone", :default => "" # Name of zone paired with free heating setpoint schedule in OA solar preheat
!x!
!x!parameter "rac", :default => false  # Run-around coil
!x!parameter "rac_eff", :default => 0.6
!x!parameter "rac_oa_min", :default => 10['F']
!x!parameter "rac_oa_max", :default => 95['F']
!x!parameter "rac_deadband", :default => 5['F']
!x!parameter "rac_pump_eff", :default => 0.9
!x!parameter "rac_pump_head", :default => 15['ft H2O']
!x!
!x!parameter "chiller_cond_hr", :default => false # Creates HR coil to provide heat to AHU system from chiller heat recovery loop
!x!parameter "chiller_hr_flow", :default => Autosize # Max water flow rate in chiller heat recovery HX
!x!
!x!#parameter "design_cool_sat",
!x!#  :default => 55['F'] # AHU system design supply air temp in cooling. Based on 20F decrease from cooling setpoint, from ASHRAE 90.1 Section G3.1.2.9.1
!x!#parameter "design_heat_sat",#
!x!#  :default => 55['F'] # AHU system design supply air temp in heating. Based on 20F increase from heating setpoint, from ASHRAE 90.1 Section G3.1.2.9.1
!x!# Before was defaulted at 55 F, same as cooling
!x!
!x!#sat_control_type   (CONSTANT | OUTDOOR-AIR | WARMEST-ZONE | AVERAGE-ZONE | HVAC-SETBACK | SCHEDULE)
!x!#sat_reset_type  hmm, CONSTANT and SCHEDULE are not resets; well, SCHEDULE should be a reset, otherwise no difference from CONSTANT
!x!#  kind of liking _reset_type
!x!#  (NONE | OUTDOOR-AIR | WARMEST-ZONE | AVERAGE-ZONE | HVAC-SETBACK | SCHEDULE)
!x!
!x!#  CONSTANT => single fixed SAT, uses sat_min_temp all the time; disable sat_max_temp
!x!#  OUTDOOR-AIR / OUTDOOR-RESET / OA-RESET => outdoor air reset: uses sat_min_temp, sat_max_temp, sat_reset_low_temp, sat_reset_high_temp for 4 temperatures
!x!#  WARMEST-ZONE => polls all the zones for cooling; uses sat_min_temp, sat_max_temp for allowed temp range; minimizes reheat energy!
!x!#  AVERAGE-ZONE => same as above but calculates SAT based on average cooling loads
!x!#  HVAC-SETBACK / NIGHT-SETBACK / OA-SETBACK / SETBACK-RESET / FOLLOW-OA / FOLLOW-OCC => follows oa_sch but gsubs 0.0 => sat_temp_max, 1.0 => sat_temp_min
!x!#  SCHEDULE => uses sat_temp_sch for a single SAT setpoint; optionally can do gsub with %1 => sat_temp_min, %2 => sat_temp_max
!x!
!x!#future:
!x!#  ZONE-REHEAT => SetpointManager:SingleZone:Reheat => used for _variable_temperature_ system for a single zone
!x!#  DUAL-DUCT-RESET => uses Warmest and Coldest with dual duct system to set SAT on cold and hot decks separately
!x!#  ??? => SetpointManager:WarmestTemperatureFlow has 2 different strategies: one like WARMEST-ZONE, other is different
!x!
!x!# might be some other complexities with dual duct systems: OA reset on each deck separately?
!x!# for dual duct:
!x!#   sat_temp_min = cold deck SAT
!x!#   sat_temp_max = hot deck SAT
!x!
!x!parameter "sat_reset_type",
!x!  :default => "NONE", :domain => String  # ["NONE", "OUTDOOR-AIR", "WARMEST-ZONE", "AVERAGE-ZONE", "HVAC-SETBACK", "SCHEDULE", "FLOATING"]
!x!
!x!parameter "sat_temp_min",  # cooling SAT    sat_min_temp / sat_temp_min  ?
!x!  :default => 52['F']  #, :domain => Numeric
!x!parameter "sat_temp_max",  # heating SAT    sat_max_temp / sat_temp_max  ?
!x!  :default => 104['F']  #, :domain => Numeric
!x!  # or maybe disable initially?
!x!parameter "sat_temp_sch",  # used with SCHEDULE only; applies single SAT setpoint; optionally can do gsub with %1 => sat_temp_min, %2 => sat_temp_max
!x!  :default => "", :domain => String
!x!
!x!parameter "heat_flow_method", # Heating Supply Air Flow Rate Method
!x!  :default => "DesignDay"
!x!parameter "heat_flow_frac", # Heating Fraction of Autosized Heating Supply Air Flow Rate. Only used when Heating Supply Air Flow Rate Method is FractionOfAutosizedHeatingAirflow
!x!  :default => Autosize, :domain => Numeric
!x!parameter "heat_flow", # Heating Supply Air Flow Rate. Only used when Heating Supply Air Flow Rate Method is Flow/System
!x!  :default => 0['CFM']
!x!
!x!parameter "cool_flow_method", # Cooling Supply Air Flow Rate Method
!x!  :default => "DesignDay"
!x!parameter "cool_flow", # Heating Supply Air Flow Rate. Only used when Heating Supply Air Flow Rate Method is Flow/System
!x!  :default => 0['CFM']
!x!
!x!#G3.1.3.12 Supply Air Temperature Reset
!x!#The air temperature for cooling shall be reset higher by 5°F under the
!x!#minimum cooling load conditions.
!x!# => applies to all the resets
!x!
!x!parameter "sat_oa_temp_min",  # used with OUTDOOR-AIR only    or sat_reset_low_temp
!x!  :default => 60['F']  #, :domain => Numeric
!x!parameter "sat_oa_temp_max",  # used with OUTDOOR-AIR only    or sat_reset_high_temp
!x!  :default => 70['F']  #, :domain => Numeric
!x!
!x!rule "fan_return_false", :parameters => {:fan_return => false} do
!x!  disable :fan_return_rise
!x!end
!x!
!x!rule "ahu_type_doas", :parameters => {:ahu_type => "DOAS"} do
!x!  force :oa_frac => 1.0
!x!  force :heat_flow_frac => 1.0
!x!  default :fan_speed => "CONSTANT"
!x!  #force :cool_flow_method => "Flow/System"
!x!  #force :heat_flow_method => "Flow/System"
!x!  force :sizing_type => "VentilationRequirement"
!x!end
!x!
!x!rule "sat_reset_type_none", :parameters => { :sat_reset_type => "NONE" } do
!x!  default :sat_temp_min => 55['F']
!x!  default :sat_temp_max => 55['F']
!x!  disable :sat_temp_sch
!x!  disable :sat_oa_temp_min
!x!  disable :sat_oa_temp_max
!x!end
!x!
!x!rule "sat_reset_type_outdoor_air", :parameters => { :sat_reset_type => "OUTDOOR-AIR" } do
!x!  default :sat_temp_min => 55['F']  # Setpoint at sat_oa_temp_max
!x!  default :sat_temp_max => 60['F']  # Setpoint at sat_oa_temp_min
!x!  default :sat_oa_temp_max => 70['F']
!x!  default :sat_oa_temp_min => 60['F']
!x!  disable :sat_temp_sch
!x!end
!x!
!x!rule "sat_reset_type_warmest_zone", :parameters => { :sat_reset_type => "WARMEST-ZONE" } do
!x!  default :sat_temp_min => 55['F']
!x!  default :sat_temp_max => 60['F']  # 5 F increase based on ASHRAE 90.1 Section G3.1.3.12
!x!  disable :sat_temp_sch
!x!  disable :sat_oa_temp_min
!x!  disable :sat_oa_temp_max
!x!end
!x!
!x!rule "sat_reset_type_average_zone", :parameters => { :sat_reset_type => "AVERAGE-ZONE" } do
!x!  default :sat_temp_min => 55['F']
!x!  default :sat_temp_max => 60['F']  # 5 F increase based on ASHRAE 90.1 Section G3.1.3.12
!x!  disable :sat_temp_sch
!x!  disable :sat_oa_temp_min
!x!  disable :sat_oa_temp_max
!x!end
!x!
!x!rule "sat_reset_type_hvac_setback", :parameters => { :sat_reset_type => "HVAC-SETBACK" } do
!x!  default :sat_temp_min => 55['F']
!x!  default :sat_temp_max => 60['F']  # 5 F increase based on ASHRAE 90.1 Section G3.1.3.12
!x!  disable :sat_temp_sch
!x!  disable :sat_oa_temp_min
!x!  disable :sat_oa_temp_max
!x!end
!x!
!x!rule "sat_reset_type_schedule", :parameters => { :sat_reset_type => "SCHEDULE" } do
!x!  default :sat_temp_min => 55['F']
!x!  default :sat_temp_max => 60['F']  # 5 F increase based on ASHRAE 90.1 Section G3.1.3.12
!x!  disable :sat_temp_sch
!x!  disable :sat_oa_temp_min
!x!  disable :sat_oa_temp_max
!x!end
!x!
!x!
!x!# FORMER--still used below
!x!#parameter "heat_sat_reset_control", :default => "NONE"  # (NONE | SCHEDULE | OUTDOORTEMP | COLDEST) Sets type of heating supply air temp reset control
!x!#parameter "heat_sat_no_reset", :default => 95['F'] # Heating supply air temp for no reset control (sets constant SAT schedule). Average of max and min SAT in coldest reset control from E+ default
!x!#parameter "heat_sat_schedule_occ", :default => 95['F'] # Heating supply air temp for schedule reset control (sets occupied SAT). Average of max and min SAT in coldest reset control from E+ default
!x!#parameter "heat_sat_schedule_reset", :default => 80['F'] # Heating supply air temp for schedule reset control (sets unoccupied/reset SAT)
!x!#parameter "heat_sat_outdoor_low_temp", :default => 30['F'] # Heating supply air temp for outdoor reset control (sets low OA temp)
!x!#parameter "heat_sat_outdoor_low_setpt", :default => 95['F'] # Heating supply air temp for outdoor reset control (sets SAT for low OA temp). Average of max and min SAT in coldest reset control from E+ default
!x!#parameter "heat_sat_outdoor_high_temp", :default => 50['F'] # Heating supply air temp for outdoor reset control (sets high OA temp)
!x!#parameter "heat_sat_outdoor_high_setpt", :default => 80['F'] # Heating supply air temp for outdoor reset control (sets SAT for high OA temp)
!x!#parameter "heat_sat_coldest_low_setpt", :default => 68['F'] # Heating supply air temp for coldest reset control (sets min SAT). E+ default
!x!#parameter "heat_sat_coldest_high_setpt", :default => 122['F']  # Heating supply air temp for coldest reset control (sets max SAT). E+ default
!x!
!x!parameter "sizing_type",  # Type of Load to Size on (Sizing:System object)
!x!  :default => "Sensible" # (Sensible | VentilationRequirement)
!x!parameter "hum_type",  # Humidifier type (if any)
!x!  :default => "NONE" # ["NONE", "RESISTANCE", "COMBUSTION"]
!x!parameter "hum_min_hr",  # Min absolute humidity ratio outlet from central AHU
!x!  :default => 0.004, :domain => Numeric
!x!parameter "hum_max_hr",  # Max absolute humidity ratio outlet from central AHU
!x!  :default => 0.02, :domain => Numeric
!x!parameter "hum_cap",  # {m3/s} Nominal water flow rate @ 5.05C in humidifer
!x!  :default => Autosize
!x!parameter "hum_power",  # {W} Nominal full output power consumption of humidifier (uses humidifer water flow capacity and enthalpy rise of water from 20C liquid to 100C steam)
!x!  :default => Autosize
!x!parameter "hum_eff",  # thermal efficiency, only applies to COMBUSTION
!x!  :default => 0.8, :domain => Numeric
!x!
!x!parameter "return_plenum", :default => false
!x!parameter "return_plenum_zone_name", # If return_plenum is true and return_plenum_zone_name is empty, a dummy return plenum zone is created automatically.
!x!  :default => ""
!x!
!x!rule "return_plenum_false", :parameters => { :return_plenum => false} do
!x!  disable :return_plenum_zone_name
!x!end
!x!
!x!parameter "clear_water_supply_tank", :default => ""
!x!%>
!x!<%
!x!
!x!# setting control_type (and other local variables)
!x!# could be done with rules that set a hidden/internal variable
!x!
!x!# can probably in-line this below instead:
!x!if (control_zone_name.empty?)
!x!  control_type = "Setpoint"
!x!else
!x!  control_type = "Load"
!x!end
!x!
!x!if (sat_temp_max.nil?)
!x!  sat_temp_max = sat_temp_min
!x!end
!x!
!x!if (sat_reset_type == "HVAC-SETBACK")
!x!  # Derive SAT schedule from OA schedule.
!x!  # NOTE: not sure this works for heating vs. cooling season?
!x!  sat_temp_sch = oa_sch.gsub(/(?<=,)\s*(1\.0*|1)\s*(?=[,;])/, " %1")  # Match values equal to 1.0
!x!  sat_temp_sch.gsub!(/(?<=,)\s*(0\.0*|\.0+|0)\s*(?=[,;])/, " %2")  # Match values equal to 0.0
!x!  sat_reset_type = "SCHEDULE"
!x!end
!x!
!x!if (sat_reset_type == "SCHEDULE")
!x!  # Original schedule is unchanged if it does not have % tags.
!x!  sat_temp_sch.gsub!(/%1/, sat_temp_min.to_s)
!x!  sat_temp_sch.gsub!(/%2/, sat_temp_max.to_s)
!x!end
!x!
!x!if (return_plenum and return_plenum_zone_name.empty?)
!x!  return_plenum_zone_name = "#{ahu_name} Return Plenum"
!x!end

!x!# this should be more explicit elsewhere!:
!x!if (fan_mode == "SCHEDULE" and fan_mode_sch.empty?)
!x!  fan_mode_sch = oa_sch  # Set cycling and continuous fan operation modes
!x!end
!x!
!x!# not needed with Unitary?
!x!controllers = []
!x!if (rac)
!x!  controllers << "#{ahu_name} Run Around Heating Mode Controller"
!x!  controllers << "#{ahu_name} Run Around Cooling Mode Controller"
!x!end
!x!if (cool_coil_type == "WATER")
!x!  controllers << "#{ahu_name} Cooling Coil Controller"
!x!end
!x!if (chiller_cond_hr)
!x!  controllers << "#{ahu_name} Cond Coil Controller"
!x!end
!x!if (heat_coil_type == "WATER")
!x!  controllers << "#{ahu_name} Heating Coil Controller"
!x!end
!x!if (heat_coil_type == "STEAM")
!x!# Added for steam boiler variant. Behzad Rizi 2024-01-24
!x!  controllers << "#{ahu_name} Heating Coil Controller"
!x!end
!x!
!x!
!x!# Check that OA flow isn't greater than AHU system flow
!x!#if (oa_flow == Autosize or fan_flow == Autosize)
!x!  # Ignore
!x!#elsif (oa_flow > fan_flow)
!x!#  puts "[WARNING] Design OA flow input is greater than AHU supply fan flow input! Design OA flow should be equal to or less than AHU supply fan flow, check inputs."
!x!#end
!x!
!x!# If modeling a DOAS AHU, hard-set supply fan flow to OA flow and min OAF schedule
!x!
!x!#if (oa_frac == 1.0)
!x!#  fan_flow = oa_flow
!x!#  oa_min_frac_sch = op_sch
!x!#end
!x!
!x!
!x!# Change to a lookup Hash:
!x!#   goal is to decouple from potential future EnergyPlus changes
!x!#   freeze all strings -- YES
!x!econ_key = {
!x!  "NONE" => "NoEconomizer",
!x!  "FIXED-DRY-BULB" => "FixedDryBulb",
!x!  "DIFFERENTIAL-DRY-BULB" => "DifferentialDryBulb"
!x!}
!x!
!x!oa_econ_type_input = ""
!x!if (oa_econ_type == "NONE")
!x!  oa_econ_type_input = "NoEconomizer"
!x!elsif (oa_econ_type == "FIXED-DRY-BULB")
!x!  oa_econ_type_input = "FixedDryBulb"
!x!elsif (oa_econ_type == "DIFFERENTIAL-DRY-BULB")
!x!  oa_econ_type_input = "DifferentialDryBulb"
!x!elsif (oa_econ_type == "FIXED-ENTHALPY")
!x!  oa_econ_type_input = "FixedEnthalpy"
!x!elsif (oa_econ_type == "DIFFERENTIAL-ENTHALPY")
!x!  oa_econ_type_input = "DifferentialEnthalpy"
!x!elsif (oa_econ_type == "ELECTRONIC-ENTHALPY")
!x!  oa_econ_type_input = "ElectronicEnthalpy"
!x!elsif (oa_econ_type == "FIXED-DEW-POINT-AND-DRY-BULB")
!x!  oa_econ_type_input = "FixedDewPointAndDryBulb"
!x!elsif (oa_econ_type == "DIFFERENTIAL-DRY-BULB-AND-ENTHALPY")
!x!  oa_econ_type_input = "DifferentialDryBulbAndEnthalpy"
!x!end
!x!
!x!oa_econ_control_action_input = ""
!x!if (oa_econ_mode == "MODULATE-FLOW" || oa_econ_mode == "DIFFERENTIAL-DRY-BULB")
!x!  oa_econ_control_action_input = "ModulateFlow"
!x!elsif (oa_econ_mode == "MINIMUM-FLOW-WITH-BYPASS")
!x!  oa_econ_control_action_input = "MinimumFlowWithBypass"
!x!end
!x!
!x!# Use new parameter to set night cycle control type to E+-compatible input string. Add warning message if input doesn't match options
!x!
!x!night_cycle_control_input = ""
!x!
!x!if (night_cycle_control_type != "NONE")
!x!  if (night_cycle_control_type == "FOLLOW-FAN-SCHEDULE")
!x!    night_cycle_control_input = "StayOff"
!x!  elsif (night_cycle_control_type == "CYCLE-AHU-FOR-ANY-ZONE")
!x!    night_cycle_control_input = "CycleOnAny"
!x!  elsif (night_cycle_control_type == "CYCLE-AHU-FOR-CONTROL-ZONE-ONLY")
!x!    night_cycle_control_input = "CycleOnControlZone"
!x!  elsif (night_cycle_control_type == "CYCLE-ZONE-FANS-ONLY")
!x!    night_cycle_control_input = "CycleOnAnyZoneFansOnly"
!x!  else
!x!    puts "[WARNING] Night cycle control type input doesn't match allowable options!"
!x!  end
!x!end
!x!
!x!# should not need this
!x!#if ahu_type == "DOAS"
!x!#    heat_flow = oa_min_flow
!x!#    cool_flow = oa_min_flow
!x!#end
!x!
!x!%>
!x!
!x!<% if (design_peak_load == "COINCIDENT")
!x!  iv_type_zone_sum = "Coincident"
!x!elsif (design_peak_load == "NONCOINCIDENT")
!x!  iv_type_zone_sum = "NonCoincident"
!x!end %>
!x!
!x!<% if (ahu_type == "DOAS" || ahu_type == "MAU")
!x!  iv_pct_oa_cooling = "Yes"
!x!  iv_pct_oa_heating = "Yes"
!x!else
!x!  iv_pct_oa_cooling = "No"
!x!  iv_pct_oa_heating = "No"
!x!end %>
!x!
!x!<% if ahu_type == "DOAS"
!x!  iv_zn_max_oa_frac = ""
!x!  iv_cool_design_cap_method = ""
!x!  iv_cool_design_cap = ""
!x!  iv_heat_design_cap = ""
!x!  iv_heat_des_cap = ""
!x!  iv_cen_cool_cap_cntrl_method = ""
!x!else
!x!  iv_zn_max_oa_frac = zone_max_oa_frac
