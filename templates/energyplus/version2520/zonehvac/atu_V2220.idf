Version, 22.2;
!x!<%#INITIALIZE
!x!require "modelkit/energyplus"
!x!
!x!parameter "atu_name",
!x!  :domain => String
!x!
!x!# drop all atu_ prefixes!! this will get prefixed externally
!x!# or maybe change: atu_type => unit_type    but atu_unit_type is redundant...
!x!
!x!parameter "atu_type",
!x!  :default => "CAV", :domain => String  # ["CAV", "CAV-CHB", "CAV-IND", "CAV-DD", "VAV", "VAV-PFP", "VAV-SFP", "VAV-DD"]
!x!
!x!parameter "atu_flow",
!x!  :default => Autosize
!x!parameter "atu_flow_min_frac",
!x!  :default => Autosize
!x!    # Hard-set min primary air flow fraction through terminal to 1.0 for CAV single and dual duct terminals.
!x!    #CAV chilled beam and induction terminals don't have this input field.
!x!    #if (atu_type == "CAV" or atu_type == "CAV-DD")
!x!    #  atu_flow_min_frac = 1.0
!x!    #end
!x!    # Seems like Autosize is the better way to go now.
!x!
!x!# Change to induction_frac
!x!parameter "atu_ind_frac",  # Ratio of induced air flow from zones to primary supply flow from central air loop. Only used with induction terminals.
!x!  :default => 2.5, :domain => Numeric
!x!
!x!parameter "atu_fan_rise",  # Terminal fan pressure rise
!x!  :default => 0.2['in H2O'], :domain => Quantity
!x!parameter "atu_fan_eff",
!x!  :default => 0.5, :domain => Numeric
!x!parameter "atu_fan_motor_eff",
!x!  :default => 0.85, :domain => Numeric
!x!parameter "atu_fan_subcat",
!x!  :default => "ATU Fans", :domain => String
!x!
!x!parameter "atu_reheat_coil_type",
!x!  :default => "RESISTANCE", :domain => String  # (RESISTANCE | WATER | NONE)
!x!parameter "atu_reheat_coil_eff",
!x!  :default => 0.98, :domain => Numeric
!x!parameter "atu_reheat_max_sat",  # Maximum air temp leaving air terminal reheat coil
!x!  :default => 104['F'], :domain => Quantity
!x!parameter "atu_reheat_max_frac",  # Maximum air flow fraction during reheat
!x!  :default => Autosize, :domain => Numeric
!x!parameter "atu_reheat_control",  # only applies to HW coil; all others do Normal action (single max) anyway
!x!  :default => "SINGLE-MAX", :domain => String  # (SINGLE-MAX | DUAL-MAX | DUAL-MAX-LIMIT)   add SINGLE-MAX-LIMITS
!x!
!x!# Disable leakage temporarily; results in unmet hours currently.
!x!parameter "atu_leak_supply_frac", :name => "ATU Supply Leakage Fraction", :description=>"Leakage fraction to return plenum in supply ducts upstream of the air terminal unit",
!x!  :default => 0.0, :domain => Numeric  # Interval [0, 0.5]
!x!parameter "atu_leak_return_frac", :name => "ATU Return Leakage Fraction", :description=>"Leakage fraction to return plenum in return ducts downstream of the air terminal unit",
!x!  :default => 0.0, :domain => Numeric  # Interval [0, 0.5]
!x!
!x!# ATU must be connected to a return plenum for duct leakage or there will be errors.
!x!# add rule: fail if there are no ducts or not compatible or something.
!x!
!x!# should import from water recycling template!
!x!parameter "clear_water_storage_tank", :default => ""
!x!
!x!
!x!#TRC - design specification OA name added so VAV terminal units can refer to it to size minimum flowrate
!x!parameter "design_spec_OA_name", :default => ""
!x!
!x!rule "atu_type_cav", :parameters => {:atu_type => "CAV"} do
!x!  force :atu_flow_min_frac => 1.0  # Unsure about this...both ways work, but slightly different results
!x!  disable :atu_ind_frac
!x!  disable :atu_fan_rise
!x!  disable :atu_fan_eff
!x!  disable :atu_fan_motor_eff
!x!  disable :atu_fan_subcat
!x!  default :atu_reheat_coil_type => "RESISTANCE"
!x!end

!x!rule "atu_type_cav_chb", :parameters => {:atu_type => "CAV-CHB"} do
!x!  disable :atu_ind_frac
!x!  disable :atu_fan_rise
!x!  disable :atu_fan_eff
!x!  disable :atu_fan_motor_eff
!x!  disable :atu_fan_subcat
!x!  force :atu_reheat_coil_type => "NONE"
!x!  disable :atu_leak_supply_frac  # Does not support simple duct leakage
!x!  disable :atu_leak_return_frac
!x!end
!x!
!x!rule "atu_type_cav_ind", :parameters => {:atu_type => "CAV-IND"} do
!x!  disable :atu_ind_frac
!x!  disable :atu_fan_rise
!x!  disable :atu_fan_eff
!x!  disable :atu_fan_motor_eff
!x!  disable :atu_fan_subcat
!x!  force :atu_reheat_coil_type => "WATER"
!x!  disable :atu_reheat_control
!x!  disable :atu_leak_supply_frac  # Does not support simple duct leakage
!x!  disable :atu_leak_return_frac
!x!end
!x!
!x!rule "atu_type_cav_dd", :parameters => {:atu_type => "CAV-DD"} do
!x!  disable :atu_ind_frac
!x!  disable :atu_fan_rise
!x!  disable :atu_fan_eff
!x!  disable :atu_fan_motor_eff
!x!  disable :atu_fan_subcat
!x!  force :atu_reheat_coil_type => "NONE"
!x!  disable :atu_leak_supply_frac  # Does not support simple duct leakage
!x!  disable :atu_leak_return_frac
!x!end
!x!
!x!rule "atu_type_vav", :parameters => {:atu_type => "VAV"} do
!x!  disable :atu_ind_frac
!x!  disable :atu_fan_rise
!x!  disable :atu_fan_eff
!x!  disable :atu_fan_motor_eff
!x!  disable :atu_fan_subcat
!x!  default :atu_reheat_coil_type => "RESISTANCE"
!x!end
!x!
!x!rule "atu_type_vav_coil_none", :parameters => {:atu_type => "VAV", :atu_reheat_coil_type => "NONE"} do
!x!  disable :atu_leak_supply_frac  # Does not support simple duct leakage
!x!  disable :atu_leak_return_frac
!x!end
!x!
!x!rule "atu_type_vav_pfp", :parameters => {:atu_type => "VAV-PFP"} do
!x!  disable :atu_ind_frac
!x!  #restrict :atu_reheat_coil_type => [all except NONE]  # must have a reheat coil
!x!  default :atu_reheat_coil_type => "RESISTANCE"
!x!  disable :atu_reheat_control
!x!  disable :atu_leak_supply_frac  # Does not support simple duct leakage
!x!  disable :atu_leak_return_frac
!x!end
!x!
!x!rule "atu_type_vav_sfp", :parameters => {:atu_type => "VAV-SFP"} do
!x!  disable :atu_ind_frac
!x!  #restrict :atu_reheat_coil_type => [all except NONE]  # must have a reheat coil
!x!  default :atu_reheat_coil_type => "RESISTANCE"
!x!  disable :atu_reheat_control
!x!  disable :atu_leak_supply_frac  # Does not support simple duct leakage
!x!  disable :atu_leak_return_frac
!x!end
!x!
!x!rule "atu_type_vav_dd", :parameters => {:atu_type => "VAV-DD"} do
!x!  disable :atu_ind_frac
!x!  force :atu_reheat_coil_type => "NONE"
!x!  disable :atu_reheat_control
!x!  disable :atu_leak_supply_frac  # Does not support simple duct leakage
!x!  disable :atu_leak_return_frac
!x!end
!x!
!x!rule "atu_reheat_coil_type_resistance", :parameters => {:atu_reheat_coil_type => "RESISTANCE"} do
!x!  default :atu_reheat_coil_eff => 1.0
!x!  default :atu_reheat_control => "SINGLE-MAX"  # do not force temporarily until rule override in import
!x!end
!x!
!x!rule "atu_reheat_coil_type_water", :parameters => {:atu_reheat_coil_type => "WATER"} do
!x!  disable :atu_reheat_coil_eff
!x!end
!x!
!x!rule "atu_reheat_coil_type_none", :parameters => {:atu_reheat_coil_type => "NONE"} do
!x!  disable :atu_reheat_coil_eff
!x!  disable :atu_reheat_max_sat
!x!  disable :atu_reheat_control
!x!end
!x!%>
!x!<%
!x!if (atu_reheat_control == "SINGLE-MAX")
!x!  atu_reheat_control_input = "Normal"
!x!elsif (atu_reheat_control == "DUAL-MAX")
!x!  atu_reheat_control_input = "Reverse"
!x!elsif (atu_reheat_control == "DUAL-MAX-LIMIT")
!x!  atu_reheat_control_input = "ReverseWithLimits"
!x!end
!x!%>
!x!
!x!<% if (atu_type == "CAV" or atu_type == "VAV")
!x!
!x!  if (atu_reheat_coil_type == "NONE")
!x!    air_term_obj_type = "AirTerminal:SingleDuct:VAV:NoReheat"
!x!  else
!x!    air_term_obj_type = "AirTerminal:SingleDuct:VAV:Reheat"
!x!  end
!x!elsif (atu_type == "CAV-CHB")
!x!  iv_air_term_obj_type = "AirTerminal:SingleDuct:ConstantVolume:CooledBeam"
!x!elsif (atu_type == "CAV-IND")
!x!  iv_air_term_obj_type = "AirTerminal:SingleDuct:ConstantVolume:FourPipeInduction"
!x!elsif (atu_type == "VAV-PFP")
!x!  iv_air_term_obj_type = "AirTerminal:SingleDuct:ParallelPIU:Reheat"
!x!elsif (atu_type == "VAV-SFP")
!x!  iv_air_term_obj_type = "AirTerminal:SingleDuct:SeriesPIU:Reheat"
!x!elsif (atu_type == "CAV-DD" or atu_type == "VAV-DD")
!x!  iv_air_term_obj_type = "AirTerminal:DualDuct:VAV"
!x!end %>
!x!
!x!<% if (atu_leak_supply_frac.nil?)
!x!  iv_air_term_name = atu_name + " ATU"
!x!  iv_upstream_leak_frac = ""
!x!  iv_downstream_leak_frac = ""
!x!else
!x!  iv_air_term_name = atu_name + " ATU"
!x!  iv_upstream_leak_frac = atu_leak_supply_frac
!x!  iv_downstream_leak_frac = atu_leak_return_frac
!x!end %>
!x!
ZoneHVAC:AirDistributionUnit,
  <%= atu_name %> Air Distribution Unit,  !- Name
  <%= atu_name %> Outlet Node,  !- Air Distribution Unit Outlet Node Name
  <%= iv_air_term_obj_type %>,                      !- Air Terminal Object Type
  <%= iv_air_term_name %>,                                      !- Air Terminal Name
  <%= iv_upstream_leak_frac %>,                              !- Nominal Upstream Leakage Fraction
  <%= iv_downstream_leak_frac %>;                              !- Constant Downstream Leakage Fraction

!x!<% if (atu_type == "CAV" or atu_type == "VAV") %>
!x!<% if (atu_reheat_coil_type == "NONE") %>
AirTerminal:SingleDuct:VAV:NoReheat,
  <%= atu_name %> ATU,     !- Name
  ,                        !- Availability Schedule Name
  <%= atu_name %> Outlet Node,  !- Air Outlet Node Name
  <%= atu_name %> Inlet Node,  !- Air Inlet Node Name
  <%= atu_flow %>,         !- Maximum Air Flow Rate {m3/s}
  Constant,                !- Zone Minimum Air Flow Input Method
  <%= atu_flow_min_frac %>,  !- Constant Minimum Air Flow Fraction
  ,                        !- Fixed Minimum Air Flow Rate {m3/s}
  ,                        !- Minimum Air Flow Fraction Schedule Name
  <% #TRC - add missing field so minimum flow can be autosized to account for OA requirement %>
  <%= design_spec_OA_name %>;  !- Design Specification Outdoor Air Object Name

!x!<% else %>

!x!<% if (atu_reheat_coil_type == "RESISTANCE")
!x!  iv_reheat_coil_type = "Coil:Heating:Electric"
!x!  iv_reheat_coil_name = atu_name + " ATU Heating Coil"
!x!elsif (atu_reheat_coil_type == "WATER")
!x!  iv_reheat_coil_type = "Coil:Heating:Water"
!x!  iv_reheat_coil_name = atu_name + " ATU Heating Coil"
!x!elsif (atu_reheat_coil_type == "STEAM")
!x!  iv_reheat_coil_type = "Coil:Heating:Steam"
!x!  iv_reheat_coil_name = atu_name + " ATU Heating Coil"
!x!end %>
!x!
!x!<% if (atu_reheat_coil_type == "WATER")
!x!  iv_max_hw_steam_flow = "Autosize"
!x!  iv_min_hw_steam_flow = 0.0
!x!elsif (atu_reheat_coil_type == "STEAM")
!x!  iv_max_hw_steam_flow = "Autosize"
!x!  iv_min_hw_steam_flow = 0.0
!x!else
!x!  iv_max_hw_steam_flow = ""
!x!  iv_min_hw_steam_flow = ""
!x!end %>

AirTerminal:SingleDuct:VAV:Reheat,
  <%= atu_name %> ATU,     !- Name
  ,                        !- Availability Schedule Name
  <%= atu_name %> Damper Outlet Node,  !- Damper Air Outlet Node Name
  <%= atu_name %> Inlet Node,  !- Air Inlet Node Name
  <%= atu_flow %>,         !- Maximum Air Flow Rate {m3/s}
  Constant,                !- Zone Minimum Air Flow Input Method
  <%= atu_flow_min_frac %>,  !- Constant Minimum Air Flow Fraction
  ,                        !- Fixed Minimum Air Flow Rate {m3/s}
  ,                        !- Minimum Air Flow Fraction Schedule Name
  <%= iv_reheat_coil_type %>,   !- Reheat Coil Object Type
  <%= iv_reheat_coil_name %>,  !- Reheat Coil Name
  <%= iv_max_hw_steam_flow %>,                !- Maximum Hot Water or Steam Flow Rate {m3/s}
  <%= iv_min_hw_steam_flow %>,                     !- Minimum Hot Water or Steam Flow Rate {m3/s}
  <%= atu_name %> Outlet Node,  !- Air Outlet Node Name
  0.001,                   !- Convergence Tolerance
  <%= atu_reheat_control_input %>,  !- Damper Heating Action
  ,                        !- Maximum Flow per Zone Floor Area During Reheat {m3/s-m2}
  <%= atu_reheat_max_frac %>,                        !- Maximum Flow Fraction During Reheat
  <%= atu_reheat_max_sat %>,  !- Maximum Reheat Air Temperature {C}
  <%= design_spec_OA_name %>;  !- Design Specification Outdoor Air Object Name
!x!<%# TRC - change so minimum flow can be autosized to account for OA requirement %>
!x!<%#
!x!Design OA controls the damper to meet outdoor air based on varying number of occupants.
!x!Do we want this in general? Or only for DCV?
!x!This fixes a lot of the unmet hours, but seems wrong to omit.
!x!
!x!adding DesignSpecification:OutdoorAir might fix it?
!x!
!x!NOTE: There can be two DesignSpecification:OutdoorAir objects:
!x!- one is used in Sizing:Zone to _design_ loads (CFM/person, etc.)
!x!- second is used here with AirTerminal:SingleDuct:VAV:Reheat for _control_ of OA based
!x!  on actual occupancy--can be different from design loads if DCV
!x!%>
!x!
!x!<%# THIS must be handled. Can't use arbitrary schedule. %>
!x!
!x!<% end %>
!x!<% elsif (atu_type == "CAV-CHB") %>
AirTerminal:SingleDuct:ConstantVolume:CooledBeam,
  <%= atu_name %> ATU,     !- Name
  ,                        !- Availability Schedule Name
  Active,                  !- Cooled Beam Type
  <%= atu_name %> Inlet Node,  !- Supply Air Inlet Node Name
  <%= atu_name %> Outlet Node,  !- Supply Air Outlet Node Name
  <%= atu_name %> Chilled Beam CW Inlet Node,  !- Chilled Water Inlet Node Name
  <%= atu_name %> Chilled Beam CW Outlet Node,  !- Chilled Water Outlet Node Name
  <%= atu_flow %>,         !- Supply Air Volumetric Flow Rate {m3/s}
  ,                        !- Maximum Total Chilled Water Volumetric Flow Rate {m3/s}
  ,                        !- Number of Beams
  ,                        !- Beam Length {m}
  ,                        !- Design Inlet Water Temperature {C}
  ,                        !- Design Outlet Water Temperature {C}
  ,                        !- Coil Surface Area per Coil Length {m2/m}
  ,                        !- Model Parameter a
  ,                        !- Model Parameter n1
  ,                        !- Model Parameter n2
  ,                        !- Model Parameter n3
  ,                        !- Model Parameter a0 {m2/m}
  ,                        !- Model Parameter K1
  ,                        !- Model Parameter n
  ,                        !- Coefficient of Induction Kin
  ;                        !- Leaving Pipe Inside Diameter {m}

Branch,
  <%= atu_name %> CW Branch,  !- Name
  ,                        !- Pressure Drop Curve Name
  AirTerminal:SingleDuct:ConstantVolume:CooledBeam,  !- Component 1 Object Type
  <%= atu_name %> ATU,     !- Component 1 Name
  <%= atu_name %> Chilled Beam CW Inlet Node,  !- Component 1 Inlet Node Name
  <%= atu_name %> Chilled Beam CW Outlet Node;  !- Component 1 Outlet Node Name

!x!<% elsif (atu_type == "CAV-IND") %>
AirTerminal:SingleDuct:ConstantVolume:FourPipeInduction,
  <%= atu_name %> ATU,     !- Name
  ,                        !- Availability Schedule Name
  <%= atu_flow %>,         !- Maximum Total Air Flow Rate {m3/s}
  <%= atu_ind_frac %>,     !- Induction Ratio {}
  <%= atu_name %> Inlet Node,  !- Supply Air Inlet Node Name
  <%= atu_name %> Secondary Inlet Node,  !- Induced Air Inlet Node Name
  <%= atu_name %> Outlet Node,  !- Air Outlet Node Name
  <%= atu_name %> Heating Coil Demand Inlet Node,  !- Hot Water Inlet Node Name
  <%= atu_name %> Cooling Coil Demand Inlet Node,  !- Cold Water Inlet Node Name
  Coil:Heating:Water,      !- Heating Coil Object Type
  <%= atu_name %> Heating Coil,  !- Heating Coil Name
  Autosize,                !- Maximum Hot Water Flow Rate {m3/s}
  0.0,                     !- Minimum Hot Water Flow Rate {m3/s}
  0.001,                   !- Heating Convergence Tolerance
  Coil:Cooling:Water,      !- Cooling Coil Object Type
  <%= atu_name %> Cooling Coil,  !- Cooling Coil Name
  Autosize,                !- Maximum Cold Water Flow Rate {m3/s}
  0.0,                     !- Minimum Cold Water Flow Rate {m3/s}
  0.001,                   !- Cooling Convergence Tolerance
  <%= atu_name %> ATU Mixer;  !- Zone Mixer Name

AirLoopHVAC:ZoneMixer,
  <%= atu_name %> ATU Mixer,  !- Name
  <%= atu_name %> Outlet Node,  !- Outlet Node Name
  <%= atu_name %> Inlet Node,  !- Inlet Node Name
  <%= atu_name %> ATU Cooling Coil Outlet Node;  !- Inlet Node Name

Coil:Cooling:Water,
  <%= atu_name %> Cooling Coil,  !- Name
  ,                        !- Availability Schedule Name
  Autosize,                !- Design Water Flow Rate {m3/s}
  Autosize,                !- Design Air Flow Rate {m3/s}
  Autosize,                !- Design Inlet Water Temperature {C}
  Autosize,                !- Design Inlet Air Temperature {C}
  Autosize,                !- Design Outlet Air Temperature {C}
  Autosize,                !- Design Inlet Air Humidity Ratio {kg-H2O/kg-air}
  Autosize,                !- Design Outlet Air Humidity Ratio {kg-H2O/kg-air}
  <%= atu_name %> Cooling Coil Demand Inlet Node,  !- Water Inlet Node Name
  <%= atu_name %> Cooling Coil Demand Outlet Node,  !- Water Outlet Node Name
  <%= atu_name %> ATU Heating Coil Outlet Node,  !- Air Inlet Node Name
  <%= atu_name %> ATU Cooling Coil Outlet Node,  !- Air Outlet Node Name
  SimpleAnalysis,          !- Type of Analysis
  CrossFlow,               !- Heat Exchanger Configuration
  <%= clear_water_storage_tank %>;  !- Condensate Collection Water Storage Tank Name

Branch,
  <%= atu_name %> CW Branch,  !- Name
  ,                        !- Pressure Drop Curve Name
  Coil:Cooling:Water,      !- Component 1 Object Type
  <%= atu_name %> Cooling Coil,  !- Component 1 Name
  <%= atu_name %> Cooling Coil Demand Inlet Node,  !- Component 1 Inlet Node Name
  <%= atu_name %> Cooling Coil Demand Outlet Node;  !- Component 1 Outlet Node Name

!x!<% elsif (atu_type == "VAV-PFP") %>
!x!
!x!<% if (atu_reheat_coil_type == "RESISTANCE")
!x!  iv_reheat_coil_obj_type = "Coil:Heating:Electric"
!x!elsif (atu_reheat_coil_type == "WATER")
!x!  iv_reheat_coil_obj_type = "Coil:Heating:Water"
!x!end %>
!x!
!x!<% if (atu_reheat_coil_type == "WATER")
!x!  iv_max_hw_steam_flow2 = "Autosize"
!x!  iv_min_hw_steam_flow2 = 0.0
!x!else
!x!  iv_max_hw_steam_flow2 = ""
!x!  iv_min_hw_steam_flow2 = ""
!x!end %>

AirTerminal:SingleDuct:ParallelPIU:Reheat,
  <%= atu_name %> ATU,     !- Name
  ,                        !- Availability Schedule Name
  <%= atu_flow %>,         !- Maximum Primary Air Flow Rate {m3/s}
  Autosize,                !- Maximum Secondary Air Flow Rate {m3/s}
  <%= atu_flow_min_frac %>,  !- Minimum Primary Air Flow Fraction
  Autosize,                !- Fan On Flow Fraction
  <%= atu_name %> Inlet Node,  !- Supply Air Inlet Node Name
  <%= atu_name %> Secondary Inlet Node,  !- Secondary Air Inlet Node Name
  <%= atu_name %> Outlet Node,  !- Outlet Node Name
  <%= atu_name %> Damper Outlet Node,  !- Reheat Coil Air Inlet Node Name
  <%= atu_name %> ATU Mixer,  !- Zone Mixer Name
  <%= atu_name %> ATU Fan,  !- Fan Name
  <%= iv_reheat_coil_obj_type %>,   !- Reheat Coil Object Type
  <%= atu_name %> ATU Heating Coil,  !- Reheat Coil Name
  <%= iv_max_hw_steam_flow2 %>,                !- Maximum Hot Water or Steam Flow Rate {m3/s}
  <%= iv_min_hw_steam_flow2 %>,                     !- Minimum Hot Water or Steam Flow Rate {m3/s}
  0.001;                   !- Convergence Tolerance

AirLoopHVAC:ZoneMixer,
  <%= atu_name %> ATU Mixer,  !- Name
  <%= atu_name %> Damper Outlet Node,  !- Outlet Node Name
  <%= atu_name %> Inlet Node,  !- Inlet Node Name
  <%= atu_name %> ATU Fan Outlet Node;  !- Inlet Node Name

Fan:ConstantVolume,
  <%= atu_name %> ATU Fan,  !- Name
  ,                        !- Availability Schedule Name
  <%= atu_fan_eff %>,      !- Fan Efficiency
  <%= atu_fan_rise %>,     !- Pressure Rise {Pa}
  Autosize,                !- Maximum Flow Rate {m3/s}
  <%= atu_fan_motor_eff %>,  !- Motor Efficiency
  1.0,                     !- Motor In Airstream Fraction
  <%= atu_name %> Secondary Inlet Node,  !- Air Inlet Node Name
  <%= atu_name %> ATU Fan Outlet Node,  !- Air Outlet Node Name
  <%= atu_fan_subcat %>;   !- End-Use Subcategory

!x!<% elsif (atu_type == "VAV-SFP") %>
!x!
!x!<% if (atu_reheat_coil_type == "RESISTANCE")
!x!  iv_reheat_coil_obj_type = "Coil:Heating:Electric"
!x!elsif (atu_reheat_coil_type == "WATER")
!x!  iv_reheat_coil_obj_type = "Coil:Heating:Water"
!x!end %>
!x!
!x!<% if (atu_reheat_coil_type == "WATER")
!x!  iv_max_hw_steam_flow = "Autosize"
!x!  iv_min_hw_steam_flow = 0.0
!x!else
!x!  iv_max_hw_steam_flow = ""
!x!  iv_min_hw_steam_flow = ""
!x!end %>

AirTerminal:SingleDuct:SeriesPIU:Reheat,
  <%= atu_name %> ATU,     !- Name
  ,                        !- Availability Schedule Name
  <%= atu_flow %>,         !- Maximum Air Flow Rate {m3/s}
  Autosize,                !- Maximum Primary Air Flow Rate {m3/s}
  <%= atu_flow_min_frac %>,  !- Minimum Primary Air Flow Fraction
  <%= atu_name %> Inlet Node,  !- Supply Air Inlet Node Name
  <%= atu_name %> Secondary Inlet Node,  !- Secondary Air Inlet Node Name
  <%= atu_name %> Outlet Node,  !- Outlet Node Name
  <%= atu_name %> Damper Outlet Node,  !- Reheat Coil Air Inlet Node Name
  <%= atu_name %> ATU Mixer,  !- Zone Mixer Name
  <%= atu_name %> ATU Fan,  !- Fan Name
  <%= iv_reheat_coil_obj_type %>,   !- Reheat Coil Object Type
  <%= atu_name %> ATU Heating Coil,  !- Reheat Coil Name
  <%= iv_max_hw_steam_flow %>,                !- Maximum Hot Water or Steam Flow Rate {m3/s}
  <%= iv_min_hw_steam_flow %>,                     !- Minimum Hot Water or Steam Flow Rate {m3/s}
  0.001;                   !- Convergence Tolerance

AirLoopHVAC:ZoneMixer,
  <%= atu_name %> ATU Mixer,  !- Name
  <%= atu_name %> ATU Fan Inlet Node,  !- Outlet Node Name
  <%= atu_name %> Inlet Node,  !- Inlet Node Name
  <%= atu_name %> Secondary Inlet Node;  !- Inlet Node Name

Fan:ConstantVolume,
  <%= atu_name %> ATU Fan,  !- Name
  ,                        !- Availability Schedule Name
  <%= atu_fan_eff %>,      !- Fan Efficiency
  <%= atu_fan_rise %>,     !- Pressure Rise {Pa}
  Autosize,                !- Maximum Flow Rate {m3/s}
  <%= atu_fan_motor_eff %>,  !- Motor Efficiency
  1.0,                     !- Motor In Airstream Fraction
  <%= atu_name %> ATU Fan Inlet Node,  !- Air Inlet Node Name
  <%= atu_name %> Damper Outlet Node,  !- Air Outlet Node Name
  <%= atu_fan_subcat %>;   !- End-Use Subcategory

!x!<% elsif (atu_type == "CAV-DD" or atu_type == "VAV-DD") %>
AirTerminal:DualDuct:VAV,
  <%= atu_name %> ATU,     !- Name
  ,                        !- Availability Schedule Name
  <%= atu_name %> Outlet Node,  !- Air Outlet Node Name
  <%= atu_name %> HD Inlet Node,  !- Hot Air Inlet Node Name
  <%= atu_name %> CD Inlet Node,  !- Cold Air Inlet Node Name
  <%= atu_flow %>,         !- Maximum Air Flow Rate {m3/s}
  <%= atu_flow_min_frac %>,  !- Zone Minimum Air Flow Fraction
  <%= design_spec_OA_name %>;  !- Design Specification Outdoor Air Object Name
!x!<%#TRC - change so minimum flow will be >= OA requirement %>
!x!<% end %>
!x!<% if (atu_reheat_coil_type == "RESISTANCE") %>
Coil:Heating:Electric,
  <%= atu_name %> ATU Heating Coil,  !- Name
  ,                        !- Availability Schedule Name
  <%= atu_reheat_coil_eff %>,  !- Efficiency
  Autosize,                !- Nominal Capacity {W}
  <%= atu_name %> Damper Outlet Node,  !- Air Inlet Node Name
  <%= atu_name %> Outlet Node;  !- Air Outlet Node Name

!x!<% elsif (atu_reheat_coil_type == "WATER") %>
!x!
!x!<% if (atu_type == "CAV-IND")
!x!  iv_air_inlet_node = atu_name + " Secondary Inlet Node"
!x!  iv_air_outlet_node = atu_name + " ATU Heating Coil Outlet Node"
!x!else
!x!  iv_air_inlet_node = atu_name + " Damper Outlet Node"
!x!  iv_air_outlet_node = atu_name + " Outlet Node"
!x!end %>

Coil:Heating:Water,
  <%= atu_name %> ATU Heating Coil,  !- Name
  ,                        !- Availability Schedule Name
  Autosize,                !- U-Factor Times Area Value {W/K}
  Autosize,                !- Maximum Water Flow Rate {m3/s}
  <%= atu_name %> Heating Coil Demand Inlet Node,  !- Water Inlet Node Name
  <%= atu_name %> Heating Coil Demand Outlet Node,  !- Water Outlet Node Name
  <%= iv_air_inlet_node %>,  !- Air Inlet Node Name
  <%= iv_air_outlet_node %>,  !- Air Outlet Node Name
  UFactorTimesAreaAndDesignWaterFlowRate,  !- Performance Input Method
  ,                        !- Rated Capacity {W}
  ,                        !- Rated Inlet Water Temperature {C}
  ,                        !- Rated Inlet Air Temperature {C}
  ,                        !- Rated Outlet Water Temperature {C}
  ;                        !- Rated Outlet Air Temperature {C}

Branch,
  <%= atu_name %> ATU HW Branch,  !- Name
  ,                        !- Pressure Drop Curve Name
  Coil:Heating:Water,      !- Component 1 Object Type
  <%= atu_name %> ATU Heating Coil,  !- Component 1 Name
  <%= atu_name %> Heating Coil Demand Inlet Node,  !- Component 1 Inlet Node Name
  <%= atu_name %> Heating Coil Demand Outlet Node;  !- Component 1 Outlet Node Name

!x!<% elsif (atu_reheat_coil_type == "STEAM") %>
!x!<% # Added for steam boiler variant. Behzad Rizi 2024-01-24 %>
!x!
!x!<% if (atu_type == "CAV-IND")
!x!  iv_air_inlet_node_name = atu_name + " Secondary Inlet Node"
!x!  iv_air_outlet_node_name = atu_name + " ATU Heating Coil Outlet Node"
!x!else
!x!  iv_air_inlet_node_name = atu_name + " Damper Outlet Node"
!x!  iv_air_outlet_node_name = atu_name + " Outlet Node"
!x!end %>

Coil:Heating:Steam,
  <%= atu_name %> ATU Heating Coil,  !- Name
  ,                        !- Availability Schedule Name
  Autosize,                !- Maximum Steam Flow Rate {m3/s}
  1,                       !- Degree of SubCooling
  10,                       !- Degree of Loop SubCooling
  <%= atu_name %> Heating Coil Demand Inlet Node,  !- Water Inlet Node Name
  <%= atu_name %> Heating Coil Demand Outlet Node,  !- Water Outlet Node Name
  <%= iv_air_inlet_node_name %>,  !- Air Inlet Node Name
  <%= iv_air_outlet_node_name %>,  !- Air Outlet Node Name
  ZoneLoadControl;     !- Coil Control Type

Branch,
  <%= atu_name %> ATU HW Branch,  !- Name
  ,                        !- Pressure Drop Curve Name
  Coil:Heating:Steam,      !- Component 1 Object Type
  <%= atu_name %> ATU Heating Coil,  !- Component 1 Name
  <%= atu_name %> Heating Coil Demand Inlet Node,  !- Component 1 Inlet Node Name
  <%= atu_name %> Heating Coil Demand Outlet Node;  !- Component 1 Outlet Node Name
!x!<% end %>

