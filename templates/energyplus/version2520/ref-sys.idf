  Version,25.2;

!x!<%#INITIALIZE
!x!require "modelkit/energyplus"
!x!
!x!parameter "ref_system_name"
!x!parameter "case_walkin_names"
!x!parameter "ref_sys_comp_names"
!x!parameter "suction_piping_location", :default=>"" # Replace by "zone_name" when applicable
!x!parameter "suction_gains", :default=>false # (true | false) if true provide suction_piping_location as well!
!x!parameter "piping_suction_ua", :default=>10 # in ['W/K']
!x!parameter "cond_curves_source", :default=>"SelfContained" # (SelfContained | MediumTemp | LowTemp)
!x!parameter "cond_fan_power", :default=>2600['W']
!x!parameter "cond_subcool", :default=>0['C']
!x!parameter "working_fluid", :default=>"R507" # TODO add other fluids R22
!x!# Behzad Rizi - parameterize condenser type
!x!parameter "condenser_type", :default=>"AirCooled" # (AirCooled | WaterCooled | EvaporativelyCooled)
!x!# Behzad Rizi, 05/03/2024 - parameterize condenser fan type & suction temperature control
!x!parameter "suction_temperature_control", :default=>"ConstantSuctionTemperature" # (ConstantSuctionTemperature | FloatSuctionTemperature)
!x!parameter "cond_fan_speed_control_type", :default=>"TwoSpeed" # (TwoSpeed | Fixed | VariableSpeed)
!x!# Afshin Faramarzi & Behzad Rizi, 11/11/2024 - parameterize saturated condensing temperature(SCT)
!x!parameter "cond_sct_delta", :default=>12['deltaF'] # in ['degF']
!x!#Behzad Rizi - parameterize activation mode for EMS object to control the saturated condensing temperature(SCT)
!x!parameter "cond_floating", :default=>false, :domain => Boolean # (true | false)
!x!parameter "cond_min_temp", :default=>25['C']
!x!# Nicholas Fette and Janik Somaiya, 2025-10-25 - parameterize air-cooled condenser heat rejection rate
!x!parameter "cond_hr_mt_air", :default=>3150.0, :description=>"Condenser heat rejection coefficient for medium-temperature, air-cooled condenser" # in ['W/K']
!x!parameter "cond_hr_lt_air", :default=>2090.0, :description=>"Condenser heat rejection coefficient for low-temperature, air-cooled condenser" # in ['W/K']
!x!%>
!x!
!x!<%
!x!case_walkin_list = "#{ref_system_name} Case And Walkin List"
!x!enduse_subcategory = "#{ref_system_name} Refrigeration"
!x!
!x!ref_sys_comp_list = "#{ref_system_name} Compressors List"
!x!%>
!x!
!x! <% if (condenser_type == "AirCooled")
!x!   ref_cond_name = ref_system_name + " Condenser Air Cooled"
!x! elsif (condenser_type == "EvaporativelyCooled")
!x!  ref_cond_name = ref_system_name + " Condenser Evaporatively Cooled"
!x! else
!x!   raise("error: unknown option condenser_type = '#{condenser_type}'")
!x! end %>
!x!
!x! <% if suction_gains
!x!    sum_ua_suct_piping = piping_suction_ua
!x!    suction_pipe_zone_name = suction_piping_location
!x! else
!x!    sum_ua_suct_piping = ""
!x!    suction_pipe_zone_name = ""
!x! end %>

  Refrigeration:System,
    <%= ref_system_name %>,  !- Name
    <%= case_walkin_list %>, !- Refrigerated Case or Walkin or CaseAndWalkInList Name
    ,                        !- Refrigeration Transfer Load or TransferLoad List Name
    <%= ref_cond_name %>,    !- Refrigeration Condenser Name
    <%= ref_sys_comp_list %>,!- Compressor or CompressorList Name
    <%= cond_min_temp %>,    !- Minimum Condensing Temperature {C}
    <%= working_fluid %>,    !- Refrigeration System Working Fluid Type
    <%= suction_temperature_control %>,  !- Suction Temperature Control Type
    ,                        !- Mechanical Subcooler Name
    ,                        !- Liquid Suction Heat Exchanger Subcooler Name
    <%= sum_ua_suct_piping %>,  !- Sum UA Suction Piping {W/K}
    <%= suction_pipe_zone_name %>,  !- Suction Piping Zone Name
    <%= enduse_subcategory %>;  !- End-Use Subcategory

!===manual===
!x!Refrigeration:CaseAndWalkInList,
!x!  <%= case_walkin_list %>,   !- Name
!x!<% EnergyPlus.each(case_walkin_names) do |case_walkin_name| %>
!x!  <%= case_walkin_name %>,  !- Case or WalkIn Name
!x!<% end %>
!x!
!x!Refrigeration:CompressorList,
!x!  <%= ref_sys_comp_list %>,   !- Name
!x!<% EnergyPlus.each(ref_sys_comp_names) do |ref_sys_comp_name| %>
!x!  <%= ref_sys_comp_name %>,  !- Refrigeration Compressor Name
!x!<% end %>
!======
!x!<% if (condenser_type == "AirCooled") %>

  Refrigeration:Condenser:AirCooled,
    <%= ref_system_name %> Condenser Air Cooled,  !- Name
    <%= ref_system_name %> Condenser HR curve,  !- Rated Effective Total Heat Rejection Rate Curve Name
    <%= cond_subcool %>,     !- Rated Subcooling Temperature Difference {deltaC}
    <%= cond_fan_speed_control_type %>,  !- Condenser Fan Speed Control Type
    <%= cond_fan_power %>,   !- Rated Fan Power {W}
    0.25,                    !- Minimum Fan Air Flow Ratio {dimensionless}
    ,                        !- Air Inlet Node Name or Zone Name
    ;                        !- End-Use Subcategory

!x!<% elsif (condenser_type == "EvaporativelyCooled") %>
! Evaporatively condenser from EnergyPlus default values
! Behzad Rizi, 2024-03-20

  Refrigeration:Condenser:EvaporativeCooled,
    <%= ref_system_name %> Condenser Evaporatively Cooled,  !- Name
    1.36e+006,               !- Rated Effective Total Heat Rejection Rate {W}
    ,                        !- Rated Subcooling Temperature Difference {deltaC}
    <%= cond_fan_speed_control_type %>,  !- Fan Speed Control Type
    <%= cond_fan_power %>,   !- Rated Fan Power {W}
    0.20,                    !- Minimum Fan Air Flow Ratio {dimensionless}
    6.63,                    !- Approach Temperature Constant Term {C}
    0.468,                   !- Approach Temperature Coefficient 2 {C}
    17.93,                   !- Approach Temperature Coefficient 3 {C}
    -0.322,                  !- Approach Temperature Coefficient 4 {dimensionless}
    0.5,                     !- Minimum Capacity Factor {dimensionless}
    5,                       !- Maximum Capacity Factor {dimensionless}
    ,                        !- Air Inlet Node Name
    autocalculate,           !- Rated Air Flow Rate {m3/s}
    200,                     !- Basin Heater Capacity {W/K}
    2,                       !- Basin Heater Setpoint Temperature {C}
    1000,                    !- Rated Water Pump Power {W}
    ,                        !- Evaporative Water Supply Tank Name
    ,                        !- Evaporative Condenser Availability Schedule Name
    General;                 !- End-Use Subcategory

!x!<% else %>
!x!<%   raise("error: unknown option condenser_type = '#{condenser_type}'") %>
!x!<% end %>
!x!<% if (cond_curves_source == "SelfContained") %>

  Curve:Linear,
    <%= ref_system_name %> Condenser HR curve,  !- Name
    0.0,                     !- Coefficient1 Constant
    500.,                    !- Coefficient2 x
    11.0,                    !- Minimum Value of x
    22.2;                    !- Maximum Value of x

!x!<% elsif (cond_curves_source == "MediumTemp") %>

  Curve:Linear,
    <%= ref_system_name %> Condenser HR curve,  !- Name
    0.0,                     !- Coefficient1 Constant
    <%= cond_hr_mt_air %>,   !- Coefficient2 x
    11.0,                    !- Minimum Value of x
    22.2;                    !- Maximum Value of x

!x!<% elsif (cond_curves_source == "LowTemp") %>

  Curve:Linear,
    <%= ref_system_name %> Condenser HR curve,  !- Name
    0.0,                     !- Coefficient1 Constant
    <%= cond_hr_lt_air %>,   !- Coefficient2 x
    11.0,                    !- Minimum Value of x
    22.2;                    !- Maximum Value of x

!x!<% end %>
!Afshin Faramarzi and Behzad Rizi, 11/11/2024 - added EnergyManagementSystem to the model to control saturated condensing temperature
!x!<% if (cond_floating) %>
!x!<% if (condenser_type == "EvaporativelyCooled")
!x!iv_output_var = "Site Outdoor Air Wetbulb Temperature"
!x!else
!x!iv_output_var = "Site Outdoor Air Drybulb Temperature"
!x!end %>

  EnergyManagementSystem:Sensor,
    T_sensor_<%= ref_system_name %>,  !- Name
    *,                       !- Output:Variable or Output:Meter Index Key Name
    <%= iv_output_var %>;    !- Output:Variable or Output:Meter Name

  EnergyManagementSystem:Actuator,
    CondensingTempOverride<%= ref_system_name %>,  !- Name
    <%= ref_system_name %>,  !- Actuated Component Unique Name
    Refrigeration:System,    !- Actuated Component Type
    Minimum Condensing Temperature;  !- Actuated Component Control Type

  EnergyManagementSystem:OutputVariable,
    <%= ref_system_name %> Cond Temp,  !- Name
    CondensingTempOverride<%= ref_system_name %>,  !- EMS Variable Name
    Averaged,                !- Type of Data in Variable
    SystemTimestep,          !- Update Frequency
    CondTempControl<%= ref_system_name %>,  !- EMS Program or Subroutine Name
    C;                       !- Units

  EnergyManagementSystem:ProgramCallingManager,
    Ref Sys Cond Temp Management <%= ref_system_name %>,  !- Name
    InsideHVACSystemIterationLoop,  !- EnergyPlus Model Calling Point
    CondTempControl<%= ref_system_name %>;  !- Program Name 1

  EnergyManagementSystem:Program,
    CondTempControl<%= ref_system_name %>,  !- Name
    SET CondensingTempOverride<%= ref_system_name %> = T_sensor_<%= ref_system_name %> + <%= cond_sct_delta %>,  !- Program Line 1
    SET CondensingTempOverride<%= ref_system_name %> = @Max <%= cond_min_temp %> CondensingTempOverride<%= ref_system_name %>;  !- Program Line 2

