  Version,25.2;

!x!<%#INITIALIZE
!x!parameter "power_generator",
!x!  :default => false, :domain => Boolean
!x!
!x!parameter "reporting_tolerance", :name => "Reporting Tolerance", :description => "Reporting tolerance for unmet hours",
!x!  :default => 2['deltaF'], :domain => Quantity
!x!%>

  Output:Diagnostics,
    DisplayExtraWarnings;    !- Key 1

  Output:SQLite,
    SimpleAndTabular;        !- Option Type

  Output:Surfaces:Drawing,DXF;

  Output:VariableDictionary,IDF;

  Output:Constructions,Constructions;

  Output:Surfaces:List,Details;

  OutputControl:Table:Style,
    CommaAndHTML,            !- Column Separator
    JtoKWH;                  !- Unit Conversion

!x!<%# NOTE: There seems to be a bug with the SystemTimestep frequency. It reports at 5-minute intervals? %>

  EnergyManagementSystem:OutputVariable,
    Electricity Facility EMS,!- Name
    EF,                      !- EMS Variable Name
    Summed,                  !- Type of Data in Variable
    ZoneTimestep,            !- Update Frequency
    NetMeterProgram,         !- EMS Program or Subroutine Name
    J;                       !- Units

!x!<% if (power_generator) %>

  EnergyManagementSystem:Sensor,
    EFP_meter,               !- Name
    ,                        !- Output:Variable or Output:Meter Index Key Name
    ElectricityProduced:Facility;  !- Output:Variable or Output:Meter Name

!x!<% end %>

  EnergyManagementSystem:Sensor,
    EFC_meter,               !- Name
    ,                        !- Output:Variable or Output:Meter Index Key Name
    Electricity:Facility;    !- Output:Variable or Output:Meter Name

  Output:Meter,NaturalGas:Facility,Hourly;

  Output:Meter,Heating:NaturalGas,Hourly;

  Output:Meter,Cooling:Electricity,Hourly;

!x!<% if (power_generator)
!x! iv_ef_setting = "Set EF = EFC_meter - EFP_meter"
!x!else
!x!  iv_ef_setting = "Set EF = EFC_meter"
!x!end %>

  EnergyManagementSystem:Program,
    NetMeterProgram,         !- Name
    <%= iv_ef_setting%>;     !- Program Line 1

  EnergyManagementSystem:ProgramCallingManager,
    OutputReporting,         !- Name
    EndOfSystemTimestepBeforeHVACReporting,  !- EnergyPlus Model Calling Point
    NetMeterProgram;         !- Program Name 1

  !ZoneComponentLoadSummary,

  Output:Table:SummaryReports,
    AnnualBuildingUtilityPerformanceSummary,  !- Report 1 Name
    InputVerificationandResultsSummary,  !- Report 2 Name
    ClimaticDataSummary,     !- Report 3 Name
    EnvelopeSummary,         !- Report 4 Name
    EquipmentSummary,        !- Report 5 Name
    ComponentSizingSummary,  !- Report 6 Name
    HVACSizingSummary,       !- Report 7 Name
    LightingSummary,         !- Report 8 Name
    DXReportMonthly,         !- Report 9 Name
    SystemSummary,           !- Report 10 Name
    SensibleHeatGainSummary, !- Report 11 Name
    EnergyConsumptionElectricityNaturalGasMonthly,  !- Report 12 Name
    EndUseEnergyConsumptionElectricityMonthly,  !- Report 13 Name
    EnergyConsumptionDieselFuelOilMonthly,  !- Report 14 Name
    EnergyConsumptionElectricityGeneratedPropaneMonthly,  !- Report 15 Name
    EnergyConsumptionCoalGasolineMonthly,  !- Report 16 Name
    EndUseEnergyConsumptionElectricityMonthly,  !- Report 17 Name
    EndUseEnergyConsumptionNaturalGasMonthly,  !- Report 18 Name
    EndUseEnergyConsumptionDieselMonthly,  !- Report 19 Name
    EndUseEnergyConsumptionFuelOilMonthly,  !- Report 20 Name
    EndUseEnergyConsumptionCoalMonthly,  !- Report 21 Name
    EndUseEnergyConsumptionPropaneMonthly,  !- Report 22 Name
    EndUseEnergyConsumptionGasolineMonthly,  !- Report 23 Name
    ZoneCoolingSummaryMonthly,  !- Report 24 Name
    ZoneHeatingSummaryMonthly;  !- Report 25 Name

  OutputControl:ReportingTolerances,
    <%= reporting_tolerance %>,  !- Tolerance for Time Heating Setpoint Not Met {deltaC}
    <%= reporting_tolerance %>;  !- Tolerance for Time Cooling Setpoint Not Met {deltaC}

  EnvironmentalImpactFactors,
    0.775556,                !- District Heating Water Efficiency
    3.180952,                !- District Cooling COP {W/W}
    0.722069,                !- District Heating Steam Conversion Efficiency
    80.7272,                 !- Total Carbon Equivalent Emission Factor From N2O {kg/kg}
    6.2727,                  !- Total Carbon Equivalent Emission Factor From CH4 {kg/kg}
    0.2727;                  !- Total Carbon Equivalent Emission Factor From CO2 {kg/kg}

  FuelFactors,
    Electricity,             !- Existing Fuel Resource Name
    3.34;                    !- Source Energy Factor {J/J}

  FuelFactors,
    NaturalGas,              !- Existing Fuel Resource Name
    1.047;                   !- Source Energy Factor {J/J}

  FuelFactors,
    FuelOilNo1,              !- Existing Fuel Resource Name
    1.01;                    !- Source Energy Factor {J/J}

  FuelFactors,
    FuelOilNo2,              !- Existing Fuel Resource Name
    1.01;                    !- Source Energy Factor {J/J}

  FuelFactors,
    Propane,                 !- Existing Fuel Resource Name
    1.01;                    !- Source Energy Factor {J/J}

  FuelFactors,
    Diesel,                  !- Existing Fuel Resource Name
    1.01;                    !- Source Energy Factor {J/J}

