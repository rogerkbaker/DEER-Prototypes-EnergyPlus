  Version,25.2;

!x!<%#INITIALIZE
!x!parameter "chiller_name"
!x!parameter "cap_type", :default => "UnitLoadFactorSensibleOnly"
!x!parameter "load_factor", :default => 7900 # in ['W/K']
!x!parameter "rated_cap", :default =>""
!x!parameter "rated_RH", :default =>""
!x!parameter "source_temp", :default=> -4['C']
!x!parameter "deltaT", :default=>8 # in ['C']
!x!parameter "cap_correction_curve_type", :default=>"LinearSHR60"
!x!parameter "cap_correction_curve_name", :default=>""
!x!parameter "shr60_factor", :default => 1.5 # dimensionless
!x!parameter "rated_fan_pwr", :default => 2200['W']
!x!parameter "rated_air_flow", :default => 14['m3/s']
!x!parameter "defrost_power", :default =>28400['W']
!x!parameter "temp_term_defrost_fraction", :default =>""
!x!parameter "htg_power_sch", :default =>
!x!"
!x!    Through: 12/31,
!x!    For:AllDays,
!x!    Interpolate:Average,
!x!    Until: 5:00,0,
!x!    Until: 5:40,1,
!x!    Until: 10:00,0,
!x!    Until: 10:40,1,
!x!    Until: 15:00,0,
!x!    Until: 15:40,1,
!x!    Until: 22:00,0,
!x!    Until: 22:50,1,
!x!    Until: 24:00,0
!x!"
!x!parameter "defrost_sch", :default=>
!x!"   Through: 12/31,
!x!    For:AllDays,
!x!    Interpolate:Average,
!x!    Until: 5:00,0,
!x!    Until: 5:30,1,
!x!    Until: 10:00,0,
!x!    Until: 10:30,1,
!x!    Until: 15:00,0,
!x!    Until: 15:30,1,
!x!    Until: 22:00,0,
!x!    Until: 22:40,1,
!x!    Until: 24:00,0
!x!"
!x!%>

  Refrigeration:AirChiller,
    <%= chiller_name %>,     !- Name
    <%= chiller_name %> Avail,  !- Availability Schedule Name
    <%= cap_type %>,         !- Capacity Rating Type
    <%= load_factor %>,      !- Rated Unit Load Factor {W/K}
    <%= rated_cap %>,        !- Rated Capacity {W}
    <%= rated_RH %>,         !- Rated Relative Humidity {percent}
    <%= source_temp %>,      !- Rated Cooling Source Temperature {C}
    <%= deltaT %>,           !- Rated Temperature Difference DT1 {deltaC}
    11.,                     !- Maximum Temperature Difference Between Inlet Air and Evaporating Temperature {deltaC}
    ,                        !- Coil Material Correction Factor {dimensionless}
    ,                        !- Refrigerant Correction Factor {dimensionless}
    <%= cap_correction_curve_type %>,  !- Capacity Correction Curve Type
    <%= cap_correction_curve_name %>,  !- Capacity Correction Curve Name
    <%= shr60_factor %>,     !- SHR60 Correction Factor {dimensionless}
    200.,                    !- Rated Total Heating Power {W}
    <%= chiller_name %> htg power sch,  !- Heating Power Schedule Name
    ,                        !- Fan Speed Control Type
    <%= rated_fan_pwr %>,    !- Rated Fan Power {W}
    <%= rated_air_flow %>,   !- Rated Air Flow {m3/s}
    ,                        !- Minimum Fan Air Flow Ratio {dimensionless}
    Electric,                !- Defrost Type
    TimeSchedule,            !- Defrost Control Type
    <%= chiller_name %> defrost sch,  !- Defrost Schedule Name
    <%= chiller_name %> htg power sch,  !- Defrost Drip-Down Schedule Name
    <%= defrost_power %>,    !- Defrost Power {W}
    <%= temp_term_defrost_fraction %>,  !- Temperature Termination Defrost Fraction to Ice {dimensionless}
    ,                        !- Vertical Location
    ;                        !- Average Refrigerant Charge Inventory {kg}

  Schedule:Compact,
    <%= chiller_name %> Avail,  !- Name
    ON/OFF,                  !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For:AllDays,             !- Field 2
    Interpolate:No,          !- Field 3
    Until: 24:00,1;          !- Field 4

  Schedule:Compact,
    <%= chiller_name %> htg power sch,  !- Name
    ON/OFF,                  !- Schedule Type Limits Name
    <%= htg_power_sch %>,    !- Field 1
    ,                        !- Field 2
    ;                        !- Field 3

  Schedule:Compact,
    <%= chiller_name %> defrost sch,  !- Name
    ON/OFF,                  !- Schedule Type Limits Name
    <%= defrost_sch %>,      !- Field 1
    ,                        !- Field 2
    ;                        !- Field 3

