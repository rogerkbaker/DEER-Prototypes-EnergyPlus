Version, 22.2;
! Inventory of EnergyPlus Objects in this Template, 
! and whether manual check/update is required
!-----------------------------------------------------------------
!  | EnergyPlus 					| Manual |
!  | Object Name					| Update |
!-----------------------------------------------------------------
!  | Daylighting:Controls				|        |
!  | Daylighting:ReferencePoint				|        |
!-----------------------------------------------------------------
!

!x!<%#INITIALIZE
!x!parameter "zone_name"
!x!
!x!parameter "x_1"
!x!parameter "y_1"
!x!parameter "z_1", :default=>3['ft']
!x!
!x!parameter "reference_points", :default=>1
!x!
!x!parameter "fraction_1", :default=>1.0
!x!
!x!parameter "x_2", :default=>''
!x!parameter "y_2", :default=>''
!x!parameter "z_2", :default=>''
!x!parameter "fraction_2", :default=>0.0
!x!
!x!parameter "azimuth", :default=>0
!x!
!x!parameter "illum_setpoint", :default=>430  # lux
!x!
!x!%>
!x!
!x!<% if (reference_points == 2)
!x!  iv_illum_setpt_ref1 = illum_setpoint
!x!  iv_daylight_ref_pt2_name = zone_name + " Daylighting Point 2"
!x!  iv_frac_zone_cont_by_ref_pt2 = fraction_2
!x!  iv_illum_setpt_ref2 = illum_setpoint
!x!<% else %>
!x!  iv_illum_setpt_ref1 = illum_setpoint
!x!  iv_daylight_ref_pt2_name = ""
!x!  iv_frac_zone_cont_by_ref_pt2 = ""
!x!  iv_illum_setpt_ref2 = ""
!x!<% end %>

Daylighting:Controls,
  <%= zone_name %> Daylighting,  !- Name
  <%= zone_name %>,        !- Zone Name
  SplitFlux,               !- Daylighting Method
  ,                        !- Availability Schedule Name
  Continuous,              !- Lighting Control Type
  0.1,                     !- Minimum Input Power Fraction for Continuous or ContinuousOff Dimming Control
  0.05,                    !- Minimum Light Output Fraction for Continuous or ContinuousOff Dimming Control
  1,                       !- Number of Stepped Control Steps
  1.0,                     !- Probability Lighting will be Reset When Needed in Manual Stepped Control
  <%= zone_name %> Daylighting Point 1,  !- Glare Calculation Daylighting Reference Point Name
  <%= azimuth %>,          !- Glare Calculation Azimuth Angle of View Direction Clockwise from Zone y-Axis {deg}
  22,                      !- Maximum Allowable Discomfort Glare Index
  ,                        !- DElight Gridding Resolution {m2}
  <%= zone_name %> Daylighting Point 1,  !- Daylighting Reference Point 1 Name
  <%= fraction_1 %>,       !- Fraction of Zone Controlled by Reference Point 1
  <%= iv_illum_setpt_ref1 %>,   !- Illuminance Setpoint at Reference Point 1 {lux}
  <%= iv_daylight_ref_pt2_name %>,  !- Daylighting Reference Point 2 Name
  <%= iv_frac_zone_cont_by_ref_pt2 %>,       !- Fraction of Zone Controlled by Reference Point 2
  <%= iv_illum_setpt_ref2 %>;   !- Illuminance Setpoint at Reference Point 2 {lux}

Daylighting:ReferencePoint,
  <%= zone_name %> Daylighting Point 1,  !- Name
  <%= zone_name %>,        !- Zone Name
  <%= x_1 %>,              !- X-Coordinate of Reference Point {m}
  <%= y_1 %>,              !- Y-Coordinate of Reference Point {m}
  <%= z_1 %>;              !- Z-Coordinate of Reference Point {m}

!x!<% if (reference_points == 2) %>
Daylighting:ReferencePoint,
  <%= zone_name %> Daylighting Point 2,  !- Name
  <%= zone_name %>,        !- Zone Name
  <%= x_2 %>,              !- X-Coordinate of Reference Point {m}
  <%= y_2 %>,              !- Y-Coordinate of Reference Point {m}
  <%= z_2 %>;              !- Z-Coordinate of Reference Point {m}
!x!<% end %>