Version, 22.2;
!x!<%#INITIALIZE
!x!require "modelkit/energyplus"
!x!
!x!parameter "zone_name"
!x!parameter "air_chiller_names"
!x!parameter "add_heater", :default => true
!x!parameter "sup_airflow", :default => 0.84['m3/s']
!x!parameter "heater_capa", :default => 800000['W']
!x!
!x!
!x!parameter "htg_sp", :default=>
!x!"Through: 12/31,
!x!  For: AllDays,
!x!  Until: 24:00,2.0"
!x!parameter "clg_sp", :default=>
!x!"Through: 12/31,
!x!  For: AllDays,
!x!  Until: 24:00,4.0"
!x!%>
!-----------------------------------------------------------------
!  | EnergyPlus 					| Manual |
!  | Object Name					| Update |
!-----------------------------------------------------------------
!  | ZoneControl:Thermostat				|        |
!  | Schedule:Compact					|  X(2)  |
!  | ScheduleTypeLimits					|        |
!  | ThermostatSetpoint:DualSetpoint			|        |
!  | ZoneHVAC:EquipmentConnections			|        |
!  | ZoneHVAC:EquipmentList				|        |
!  | ZoneHVAC:UnitHeater				|        |
!  | Coil:Heating:Electric				|        |
!  | Fan:ConstantVolume 				|        |
!  | ZoneHVAC:RefrigerationChillerSet			|        |
!-----------------------------------------------------------------
!

  ZoneControl:Thermostat,
    <%= zone_name %> Thermostat,     !- Name
    <%= zone_name %>,                !- Zone or ZoneList Name
    <%= zone_name %> control type sch,  !- Control Type Schedule Name
    ThermostatSetpoint:DualSetpoint,  !- Control 1 Object Type
    <%= zone_name %> Setpoints;    !- Control 1 Name
  
  Schedule:Compact,
    <%= zone_name %> control type sch,  !- Name
    <%= zone_name %> Control Type,            !- Schedule Type Limits Name
    Through: 12/31,          !- Field 1
    For: AllDays,            !- Field 2
    Until: 24:00,4;          !- Field 3

  ScheduleTypeLimits,
    <%= zone_name %> Control Type,            !- Name
    0,                       !- Lower Limit Value
    4,                       !- Upper Limit Value
    DISCRETE;                !- Numeric Type

  ThermostatSetpoint:DualSetpoint,
    <%= zone_name %> Setpoints,    !- Name
    <%= zone_name %> Heating Setpoints sch,!- Heating Setpoint Temperature Schedule Name
    <%= zone_name %> Cooling Setpoints sch;!- Cooling Setpoint Temperature Schedule Name

!x!  Schedule:Compact,
!x!    <%= zone_name %> Heating Setpoints sch,!- Name
!x!    Temperature,             !- Schedule Type Limits Name
!x!    <%= htg_sp %>;
!x!
!x!  Schedule:Compact,
!x!    <%= zone_name %> Cooling Setpoints sch,!- Name
!x!    Temperature,             !- Schedule Type Limits Name
!x!    <%= clg_sp %>;

!x!<% if (add_heater)
!x!    zone_air_exh_node_name = zone_name + " Exhaust Nodes"
!x!    zone_equip1_heat_seq = 2
!x!    zone_equip2_obj_type = "ZoneHVAC:UnitHeater"
!x!    zone_equip2_name = zone_name + " unit heater"
!x!    zone_equip2_cool_seq = 2
!x!    zone_equip2_heat_seq = 1
!x! else
!x!    zone_air_exh_node_name = ""
!x!    zone_equip1_heat_seq = 1
!x!    zone_equip2_obj_type = ""
!x!    zone_equip2_name = ""
!x!    zone_equip2_cool_seq = ""
!x!    zone_equip2_heat_seq = ""
!x!
!x! end %>

  ZoneHVAC:EquipmentConnections,
    <%= zone_name %>,                !- Zone Name
    <%= zone_name %> ref equipment,       !- Zone Conditioning Equipment List Name
    <%= zone_name %> Inlet Nodes,  !- Zone Air Inlet Node or NodeList Name
    <%= zone_air_exh_node_name %>,  !- Zone Air Exhaust Node or NodeList Name
    <%= zone_name %> air node,                 !- Zone Air Node Name
    <%= zone_name %> return air node;                 !- Zone Return Air Node or NodeList Name

  ZoneHVAC:EquipmentList,
    <%= zone_name %> ref equipment,       !- Name
    SequentialLoad,          !- Load Distribution Scheme
    ZoneHVAC:RefrigerationChillerSet,  !- Zone Equipment 1 Object Type
    <%= zone_name %> chiller set,      !- Zone Equipment 1 Name
    1,                       !- Zone Equipment 1 Cooling Sequence
    <%= zone_equip1_heat_seq %>,                       !- Zone Equipment 1 Heating or No-Load Sequence
    ,                        !- Zone Equipment 1 Sequential Cooling Fraction Schedule Name
    ,                        !- Zone Equipment 1 Sequential Heating Fraction Schedule Name
    <%= zone_equip2_obj_type %>,     !- Zone Equipment 2 Object Type
    <%= zone_equip2_name %>,        !- Zone Equipment 2 Name
    <%= zone_equip2_cool_seq %>,                       !- Zone Equipment 2 Cooling Sequence
    <%= zone_equip2_heat_seq %>,                       !- Zone Equipment 2 Heating or No-Load Sequence
    ,                        !- Zone Equipment 2 Sequential Cooling Fraction Schedule Name
    ;                        !- Zone Equipment 2 Sequential Heating Fraction Schedule Name

!x!<% if (add_heater) %>
  ZoneHVAC:UnitHeater,
    <%= zone_name %> unit heater,        !- Name
    <%= zone_name %> unit heater avail,    !- Availability Schedule Name
    <%= zone_name %> Exhaust Nodes,  !- Air Inlet Node Name
    <%= zone_name %> Inlet Nodes,  !- Air Outlet Node Name
    Fan:ConstantVolume,      !- Supply Air Fan Object Type
    <%= zone_name %> unit heater fan,     !- Supply Air Fan Name
    <%= sup_airflow %>,                    !- Maximum Supply Air Flow Rate {m3/s}
    Coil:Heating:Electric,   !- Heating Coil Object Type
    <%= zone_name %> unit heater coil,  !- Heating Coil Name
    ,                        !- Supply Air Fan Operating Mode Schedule Name
    Yes,                     !- Supply Air Fan Operation During No Heating
    ,                        !- Maximum Hot Water or Steam Flow Rate {m3/s}
    ,                        !- Minimum Hot Water or Steam Flow Rate {m3/s}
    0.001;                   !- Heating Convergence Tolerance

  Coil:Heating:Electric,
    <%= zone_name %> unit heater coil,  !- Name
    <%= zone_name %> unit heater avail,    !- Availability Schedule Name
    1.0,                     !- Efficiency
    <%= heater_capa %>,                 !- Nominal Capacity {W}
    <%= zone_name %> unit heater coil inlet node,  !- Air Inlet Node Name
    <%= zone_name %> Inlet Nodes;  !- Air Outlet Node Name

  Fan:ConstantVolume,
    <%= zone_name %> unit heater fan,     !- Name
    <%= zone_name %> unit heater avail,    !- Availability Schedule Name
    0.5,                     !- Fan Total Efficiency
    75.0,                    !- Pressure Rise {Pa}
    <%= sup_airflow %>,                    !- Maximum Flow Rate {m3/s}
    0.9,                     !- Motor Efficiency
    1.0,                     !- Motor In Airstream Fraction
    <%= zone_name %> Exhaust Nodes,  !- Air Inlet Node Name
    <%= zone_name %> unit heater coil inlet node;  !- Air Outlet Node Name

  Schedule:Compact,
    <%= zone_name %> unit heater avail,    !- Name
    Control Type,            !- Schedule Type Limits Name
    Through: 3/31,           !- Field 1
    For: AllDays,            !- Field 2
    Until: 24:00,1,          !- Field 3
    Through: 9/30,           !- Field 5
    For: AllDays,            !- Field 6
    Until: 24:00,0,          !- Field 7
    Through: 12/31,          !- Field 9
    For: AllDays,            !- Field 10
    Until: 24:00,1;          !- Field 11
!x!<% end %>

!===manual===  
!x!ZoneHVAC:RefrigerationChillerSet,
!x!    <%= zone_name %> chiller set,      !- Name
!x!    ,                        !- Availability Schedule Name
!x!    <%= zone_name %>,                !- Zone Name
!x!    ,                        !- Air Inlet Node Name
!x!    ,                        !- Air Outlet Node Name
!x!<% EnergyPlus.each(air_chiller_names) do |air_chiller_name| %>
!x!  <%= air_chiller_name %>,  !- Refrigeration Compressor Name
!x!<% end %>

