Version, 22.2;
!x!<%#INITIALIZE
!x!parameter "zone_name"         # Primary zone where mixing occurs
!x!parameter "source_zone_name"  # Secondary zone where mixing air originates from
!x!
!x!parameter "zone_flow", :default=>0.0
!x!parameter "zone_flow_ach", :default=>1
!x!parameter "mix_calc_method", :default=>"AirChanges/Hour"    # Flow/Zone | Flow/Area | Flow/Person | AirChanges/Hour
!x!parameter "mixing_schedule", :default=> "Through: 12/31,\n  For: AllDays,\n  Until: 24:00, 1.0;"
!x!
!x!%>
!-----------------------------------------------------------------
!  | EnergyPlus 					| Manual |
!  | Object Name					| Update |
!-----------------------------------------------------------------
!  | ZoneMixing						|        |
!  | Schedule:Compact					|   X    |
!-----------------------------------------------------------------
!

ZoneMixing,
  <%= zone_name + " : " + source_zone_name %> Zone Mixing,  !- Name
  <%= zone_name %>,                 !- Zone Name
  <%= zone_name + " : " + source_zone_name %> Air Mixing Schedule,       !- Schedule Name
  <%= mix_calc_method %>,               !- Design Flow Rate Calculation Method
  <%= zone_flow %>,       !- Design Flow Rate {m3/s}
  ,                        !- Flow Rate per Zone Floor Area {m3/s-m2}
  ,                        !- Flow Rate per Person {m3/s-person}
  <%= zone_flow_ach %>,                        !- Air Changes per Hour {1/hr}
  <%= source_zone_name %>,                  !- Source Zone Name
  0.0;                     !- Delta Temperature {deltaC}

!x!Schedule:Compact,
!x!  <%= zone_name + " : " + source_zone_name%> Air Mixing Schedule,       !- Schedule Name
!x!  Unit Interval,           !- Schedule Type Limits Name
!x!  <%= mixing_schedule %>;
