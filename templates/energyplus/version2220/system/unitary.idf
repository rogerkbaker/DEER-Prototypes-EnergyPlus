!x!<% elsif (heat_coil_type == "DX-AIR" and dx_comp_speed_num > 1) %>

!x!<% if (fan_config == "DRAW-THROUGH" and cool_coil_type == "NONE")
!x!  iv_air_inlet_node_nm = unitary_name + " Unitary Inlet Node"
!x!elsif (fan_config == "BLOW-THROUGH" and cool_coil_type == "NONE")
!x!  iv_air_inlet_node_nm = unitary_name + " Supply Fan Outlet Node"
!x!else
!x!  iv_air_inlet_node_nm = unitary_name + " Cooling Coil Outlet Node"
!x!end %>
!x!
!x!<% if (fan_config == "BLOW-THROUGH" and aux_heat_coil_type == "NONE")
!x!  iv_air_outlet_node_nm = unitary_name + " Unitary Outlet Node"
!x!else
!x!  iv_air_outlet_node_nm = unitary_name + " Heating Coil Outlet Node"
!x!end %>
!x!
!x!<% if (dx_comp_speed_num == 2)
!x!  iv_rated_heat_cap = heat_coil_cap
!x!else
!x!  iv_rated_heat_cap = "Autosize"
!x!end %>
!x!
!x!<% if (dx_comp_speed_num < 3)
!x!  iv_waste_heat_func_temp_curve_nm = unitary_name + " HP_Heat-Waste"
!x!  iv_total_heat_cap3 = ""
!x!  iv_rated_cop3 = ""
!x!  iv_rated_airflow3 = ""
!x!  iv_tot_heat_cap_temp_curve3_nm = ""
!x!  iv_tot_heat_cap_flow_curve3_nm = ""
!x!  iv_eir_temp_curve3_nm = ""
!x!  iv_eir_flow_curve3_nm = ""
!x!  iv_plf_curve3_nm = ""
!x!  iv_waste_ht_frac_power3 = ""
!x!
!x!else
!x!  iv_waste_heat_func_temp_curve2_nm = unitary_name + " HP_Heat-Waste"
!x!  iv_total_heat_cap3 = "Autosize"
!x!  iv_rated_cop3 = heat_coil_cop_3
!x!  iv_rated_airflow3 = "Autosize"
!x!  iv_tot_heat_cap_temp_curve3_nm = unitary_name + " HP_Heat-Cap-fT3"
!x!  iv_tot_heat_cap_flow_curve3_nm = unitary_name + " HP_Heat-Cap-fFF3"
!x!  iv_eir_temp_curve3_nm = unitary_name + " HP_Heat-EIR-fT3"
!x!  iv_eir_flow_curve3_nm = unitary_name + " HP_Heat-EIR-fFF3"
!x!  iv_plf_curve3_nm = unitary_name + " HP_Heat-PLF-fPLR3"
!x!  iv_waste_ht_frac_power3 = 0.2
!x! 
!x! if (dx_comp_speed_num < 4)
!x!  iv_waste_heat_func_temp_curve2_nm = unitary_name + " HP_Heat-Waste"
!x!  iv_total_heat_cap4 = ""
!x!  iv_rated_cop4 = ""
!x!  iv_rated_airflow4 = ""
!x!  iv_tot_heat_cap_temp_curve4_nm = ""
!x!  iv_tot_heat_cap_flow_curve4_nm = ""
!x!  iv_eir_temp_curve4_nm = ""
!x!  iv_eir_flow_curve4_nm = ""
!x!  iv_plf_curve4_nm = ""
!x!  iv_waste_ht_frac_power4 = ""
!x!  iv_waste_heat_func_temp_curve_nm = ""
!x!
!x! else
!x!  iv_waste_heat_func_temp_curve3_nm = unitary_name + " HP_Heat-Waste"
!x!  iv_total_heat_cap4 = heat_coil_cap
!x!  iv_rated_cop4 = heat_coil_cop_4
!x!  iv_rated_airflow4 = "Autosize"
!x!  iv_tot_heat_cap_temp_curve4_nm = unitary_name + " HP_Heat-Cap-fT4"
!x!  iv_tot_heat_cap_flow_curve4_nm = unitary_name + " HP_Heat-Cap-fFF4"
!x!  iv_eir_temp_curve4_nm = unitary_name + " HP_Heat-EIR-fT4"
!x!  iv_eir_flow_curve4_nm = unitary_name + " HP_Heat-EIR-fFF4"
!x!  iv_plf_curve4_nm = unitary_name + " HP_Heat-PLF-fPLR4"
!x!  iv_waste_ht_frac_power4 = 0.2
!x!  iv_waste_heat_func_temp_curve4_nm = unitary_name + " HP_Heat-Waste"
!x!
!x! end
!x!end %>

Coil:Heating:DX:MultiSpeed,
  <%= unitary_name %> Heating Coil,  !- Name
  ,                        !- Availability Schedule Name
  <%= iv_air_inlet_node_nm %>,  !- Air Inlet Node Name
  <%= iv_air_outlet_node_nm %>,  !- Air Outlet Node Name
  <%= hp_min_temp %>,      !- Minimum Outdoor Dry-Bulb Temperature for Compressor Operation {C}
  ,                        !- Outdoor Dry-Bulb Temperature to Turn On Compressor {C}
  <%= dx_crankcase_cap %>,  !- Crankcase Heater Capacity {W}
  <%= dx_crankcase_max_temp %>,  !- Maximum Outdoor Dry-Bulb Temperature for Crankcase Heater Operation {C}
  <%= unitary_name %> DefrostEIR,  !- Defrost Energy Input Ratio Function of Temperature Curve Name
  <%= hp_defrost_temp %>,  !- Maximum Outdoor Dry-Bulb Temperature for Defrost Operation {C}
  ReverseCycle,            !- Defrost Strategy
  Timed,                   !- Defrost Control
  0.0,                     !- Defrost Time Period Fraction
  ,                        !- Resistive Defrost Heater Capacity {W}
  No,                      !- Apply Part Load Fraction to Speeds Greater than 1
  Electricity,             !- Fuel Type
  ,                        !- Region number for Calculating HSPF
  <%= dx_comp_speed_num %>,  !- Number of Speeds
  Autosize,    !- Rated Total Heating Capacity {W}
  <%= heat_coil_cop_1 %>,  !- Rated COP
  <%= fan_flow %>,         !- Rated Air Flow Rate {m^3/s}
  ,                        !- 2017 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m/s)}
  ,                        !- 2023 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m/s)}
  <%= unitary_name %> HP_Heat-Cap-fT1,  !- Total Heating Capacity Function of Temperature Curve Name
  <%= unitary_name %> HP_Heat-Cap-fFF1,  !- Total Heating Capacity Function of Flow Fraction Curve Name
  <%= unitary_name %> HP_Heat-EIR-fT1,  !- Energy Input Ratio Function of Temperature Curve Name
  <%= unitary_name %> HP_Heat-EIR-fFF1,  !- Energy Input Ratio Function of Flow Fraction Curve Name
  <%= unitary_name %> HP_Heat-PLF-fPLR1,  !- Part Load Fraction Correlation Curve Name
  0.2,                     !- Rated Waste Heat Fraction of Power Input
  <%= unitary_name %> HP_Heat-Waste,  !- Waste Heat Function of Temperature Curve Name
  <%= iv_rated_heat_cap %>,   !- Rated Total Heating Capacity {W}
  <%= heat_coil_cop_2 %>,  !- Rated COP
  Autosize,                !- Rated Air Flow Rate {m^3/s}
  ,                        !- 2017 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m/s)}
  ,                        !- 2023 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m/s)}
  <%= unitary_name %> HP_Heat-Cap-fT2,  !- Total Heating Capacity Function of Temperature Curve Name
  <%= unitary_name %> HP_Heat-Cap-fFF2,  !- Total Heating Capacity Function of Flow Fraction Curve Name
  <%= unitary_name %> HP_Heat-EIR-fT2,  !- Energy Input Ratio Function of Temperature Curve Name
  <%= unitary_name %> HP_Heat-EIR-fFF2,  !- Energy Input Ratio Function of Flow Fraction Curve Name
  <%= unitary_name %> HP_Heat-PLF-fPLR2,  !- Part Load Fraction Correlation Curve Name
  0.2,                     !- Rated Waste Heat Fraction of Power Input
  <%= iv_waste_heat_func_temp_curve2_nm %>,  !- Waste Heat Function of Temperature Curve Name
  <%= iv_total_heat_cap3 %>,                !- Rated Total Heating Capacity {W}
  <%= iv_rated_cop3 %>,  !- Rated COP
  <%= iv_rated_airflow3 %>,                !- Rated Air Flow Rate {m^3/s}
  ,                        !- 2017 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m/s)}
  ,                        !- 2023 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m/s)}
  <%= iv_tot_heat_cap_temp_curve3_nm %>,  !- Total Heating Capacity Function of Temperature Curve Name
  <%= iv_tot_heat_cap_flow_curve3_nm %>,  !- Total Heating Capacity Function of Flow Fraction Curve Name
  <%= iv_eir_temp_curve3_nm %>,  !- Energy Input Ratio Function of Temperature Curve Name
  <%= iv_eir_flow_curve3_nm %>,  !- Energy Input Ratio Function of Flow Fraction Curve Name
  <%= iv_plf_curve3_nm %>,  !- Part Load Fraction Correlation Curve Name
  <%= iv_waste_ht_frac_power3 %>,                     !- Rated Waste Heat Fraction of Power Input
  <%= iv_waste_heat_func_temp_curve3_nm %>,  !- Waste Heat Function of Temperature Curve Name
  <%= iv_total_heat_cap4 %>,                !- Rated Total Heating Capacity {W}
  <%= iv_rated_cop4 %>,  !- Rated COP
  <%= iv_rated_airflow4 %>,                !- Rated Air Flow Rate {m^3/s}
  ,                        !- 2017 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m/s)}
  ,                        !- 2023 Rated Evaporator Fan Power Per Volume Flow Rate {W/(m/s)}
  <%= iv_tot_heat_cap_temp_curve4_nm %>,  !- Total Heating Capacity Function of Temperature Curve Name
  <%= iv_tot_heat_cap_flow_curve4_nm %>,  !- Total Heating Capacity Function of Flow Fraction Curve Name
  <%= iv_eir_temp_curve4_nm %>,  !- Energy Input Ratio Function of Temperature Curve Name
  <%= iv_eir_flow_curve4_nm %>,  !- Energy Input Ratio Function of Flow Fraction Curve Name
  <%= iv_plf_curve4_nm %>,  !- Part Load Fraction Correlation Curve Name
  <%= iv_waste_ht_frac_power4 %>,                     !- Rated Waste Heat Fraction of Power Input
  <%= iv_waste_heat_func_temp_curve4_nm %>;  !- Waste Heat Function of Temperature Curve Name


