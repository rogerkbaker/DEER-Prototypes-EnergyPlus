  <%= iv_spd4_waste_heat_frac_power %>,                     !- Speed 4 Rated Waste Heat Fraction of Power Input
  <%= iv_spd4_waste_heat_vs_temp_curve_nm %>,  !- Speed 4 Waste Heat Function of Temperature Curve Name
  <%= iv_spd4_evap_cond_eff %>,  !- Speed 4 Evaporative Condenser Effectiveness
  <%= iv_spd4_evap_cond_af_rate %>,                !- Speed 4 Evaporative Condenser Air Flow Rate {m^3/s}
