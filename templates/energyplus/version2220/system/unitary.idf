Version, 22.2;
! Inventory of EnergyPlus Objects in this Template, 
! and whether manual check/update is required
!-------------------------------------------------------------------------
!  | EnergyPlus 						| Manual |
!  | Object Name						| Update |
!-------------------------------------------------------------------------
!  | AirLoopHVAC:UnitarySystem					|        |
!  | Schedule:Compact						|   X    |
!  | Fan:OnOff							|        |
!  | Fan:SystemModel						|        |
!  | Curve:Quartic						|        |
!  | Fan:VariableVolume						|        |
!  | Coil:Cooling:DX:SingleSpeed				|        |
!  | Curve:Biquadratic						|        |
!  | Curve:Quadratic						|        |
!  | Curve:Cubic						|        |
!  | Coil:Cooling:DX:MultiSpeed					|        |
!  | Coil:Cooling:WaterToAirHeatPump:EquationFit		|        |
!  | Curve:QuadLinear						|        |
!  | Coil:Cooling:WaterToAirHeatPump:VariableSpeedEquationFit	|        |
!  | Coil:Cooling:Water						|        |
!  | Branch							|        |
!  | Coil:Heating:Fuel						|        |
!  | Coil:Heating:Gas:MultiStage				|        |
!  | Coil:Heating:Electric					|        |
!  | Coil:Heating:DX:SingleSpeed				|        |
!  | Coil:Heating:DX:MultiSpeed					|        |
!  | Coil:Heating:WaterToAirHeatPump:EquationFit		|        |
!  | Coil:Heating:WaterToAirHeatPump:VariableSpeedEquationFit	|        |
!  | Coil:Heating:Water						|        |
!  | Coil:Heating:Steam						|        |
!  | Coil:Heating:Fuel						|        |
!  | Coil:Heating:Electric					|        |
!  | UnitarySystemPerformance:Multispeed			|        |
!  | EnergyManagementSystem:Actuator				|        |
!  | EnergyManagementSystem:ProgramCallingManager		|        |
!  | EnergyManagementSystem:Program				|        |
!  | EnergyManagementSystem:InternalVariableXZ			|        |
!-------------------------------------------------------------------------
!
!x!<%#INITIALIZE
!x!require "modelkit/energyplus"
!x!
!x!parameter "unitary_name"
!x!
!x!parameter "doas", :default => false
!x!parameter "control_zone_name", :default => ""
!x!
!x!parameter "op_sch", :default => "Through: 12/31,\n  For: AllDays,\n  Until: 24:00, 1;"
!x!
!x!parameter "fan_type", :default => "SYSTEM-MODEL" # (ON-OFF | VAV | SYSTEM-MODEL )
!x!parameter "fan_speed", :default => "CONSTANT"  # (CONSTANT | DUAL| VARIABLE)  Fan:SystemModel allows multi-speed => DUAL
!x!parameter "fan_curve", :default => "T24"  # TRC: Added existing parameter to this template (MZVAV-FC | MZVAV-VSD | T24) 
!x!parameter "fan_sizing_method", :default => "TotalEfficiencyAndPressure" # (only relevant when fan_type = "SYSTEM-MODEL". Options: PowerPerFlow | PowerPerFlowPerPressure | TotalEfficiencyAndPressure )
!x!parameter "fan_power_per_flow", :default => 0.85['W/CFM']  # (only relevant when fan_type = "SYSTEM-MODEL" and fan_sizing_method = "PowerPerFlow")
!x!parameter "fan_power_per_flow_pressure", :default => 1.67  # W/((m3/s)-Pa) (only relevant when fan_type = "SYSTEM-MODEL" and fan_sizing_method = "PowerPerFlowPerPressure")
!x!parameter "fan_low_speed_flow_frac", :default => 0.66 # (only relevant when fan_type = "SYSTEM-MODEL" and fan_speed = "DUAL")
!x!parameter "fan_low_speed_power_frac", :default => 0.4 # (only relevant when fan_type = "SYSTEM-MODEL" and fan_speed = "DUAL")
!x!
!x!#TRC - "SWHC023-05" measure: Adding the following variables to parameterize the multi-speed operation air flow ratio and associated supply fan power for UnitarySystems
!x!parameter "low_heating_supply_air_ratio", :default => 0.75
!x!parameter "low_cooling_supply_air_ratio", :default => 0.75
!x!parameter "ventilation_supply_air_ratio", :default => 0.4
!x!parameter "constant_fan_speed_power_frac", :default => 1
!x!parameter "fan_speed_1_flow_frac", :default => 0.4
!x!parameter "fan_speed_1_power_frac", :default => 0.124709051
!x!parameter "fan_speed_2_flow_frac", :default => 0.75
!x!parameter "fan_speed_2_power_frac", :default => 0.463912917
!x!parameter "fan_speed_3_flow_frac", :default => 1
!x!parameter "fan_speed_3_power_frac", :default => 1
!x!parameter "single_mode_operation", :default => "No"
!x!
!x!parameter "fan_config", :default => "DRAW-THROUGH"  # (DRAW-THROUGH | BLOW-THROUGH)
!x!parameter "fan_mode", :default => "CYCLING"  # (CYCLING | CONTINUOUS | SCHEDULE)  # If fan_mode is SCHEDULE, fan_mode_sch cannot be empty.
!x!parameter "fan_mode_sch", :default => ""  # 0 means cycling; 1 means continuous
!x!
!x!rule "fan_mode_cycling", :parameters => {:fan_mode => "CYCLING"} do
!x!  force :fan_mode_sch => "Through: 12/31,\n  For: AllDays,\n  Until: 24:00, 0;"
!x!end
!x!
!x!rule "fan_mode_continuous", :parameters => {:fan_mode => "CONTINUOUS"} do
!x!  force :fan_mode_sch => "Through: 12/31,\n  For: AllDays,\n  Until: 24:00, 1;"
!x!end
!x!
!x!rule "fan_speed_dual", :parameters => {:fan_speed => "DUAL"} do
!x!  force :dx_comp_speed => "DUAL-EQUAL" # 2-speed fans require 2-speed/multispeed cooling coils to operate correctly
!x!end
!x!
!x!#G3.1.3.1 The systems shall be controlled to energize auxiliary heat only when the
!x!#outdoor air temperature is less than 40°F.
!x!
!x!parameter "fan_rise", :default => 0.5['in H2O']
!x!parameter "fan_eff", :name => "Supply Fan Efficiency", :description => "Total efficiency of supply fan",
!x!  :default => 0.65, :domain => Numeric  # Interval 0-1
!x!parameter "fan_motor_eff", :default => 0.85  # Efficiency of supply fan motor. Look up ASHRAE 90.1 Table 10.8-2
!x!parameter "fan_motor_frac", :default => 1.0  # Fraction of motor heat to air stream (zero means completely outside air stream)
!x!
!x!parameter "fan_flow",
!x!  :default => Autosize, :domain => Quantity
!x!
!x!parameter "fan_flow_min_method", :default=>"Fraction"
!x!parameter "fan_flow_min_frac", :default => 0.25  # For VARIABLE fan systems only
!x!parameter "fan_flow_min", :default=>0 # Fan Power Minimum Air Flow Rate (relevant when fan_flow_min_method = "FixedFlowRate")
!x!parameter "fan_subcat", :default => "Unitary Fans"  # End-use subcategory for the fan
!x!
!x!  # need fan_min_flow, fan_max_flow  ??   for VAV;  relates to fan_flow_min_frac obviously:  frac = min ÷ max
!x!
!x!parameter "cool_coil_type", :default => "DX-AIR"  # (DX-AIR | DX-EVAP | DX-WATER | WATER | NONE)
!x!parameter "cool_coil_cap", :default => Autosize
!x!parameter "cool_coil_cop", :default => 3.23
!x!parameter "cool_coil_evap_eff", :default => 0.9  # Evaporative Condenser Effectiveness
!x!
!x!#TRC - Add cool_flow_min_frac as the minimum flow ratio in cooling in the sizing:zone object and the UnitarySystem.
!x!#Differs from ATU_flow_min_frac because it cannot be autosized and it doesn't override the ventilation requirement.
!x!parameter "cool_flow_min_frac", :name => "Cooling Minimum Air Flow Fraction",:description => "Cooling Minimum Air Flow Fraction used in sizing:zone object",:default => nil
!x!#TRC - Add unitary_no_load_flow_method to parameterize the sizing of the no load (minimum) flow for UnitarySystems with DX cooling
!x!parameter "unitary_no_load_flow_method", :name => "No Load Supply Air Flow Rate Method",:description => "No Load Supply Air Flow Rate Method in AirLoopHVAC:UnitarySysteem",:default => "SupplyAirFlowRate"
!x!
!x!
!x!parameter "heat_coil_type", :default => "COMBUSTION"  # (COMBUSTION | RESISTANCE | DX-AIR | DX-WATER | WATER | STEAM | NONE)
!x!parameter "heat_coil_cap", :default => Autosize
!x!parameter "heat_coil_cop", :default => 3.23
!x!parameter "heat_coil_eff", :default => 0.8
!x!parameter "heat_coil_fuel", :default => "NaturalGas"  # (NaturalGas | Propane | ...)
!x!
!x!# should these be:
!x!#   coil_heat___
!x!#   coil_cool___
!x!#   coil_aux___     coil_supp___   coil_sec___
!x!
!x!# YES
!x!
!x!
!x!parameter "heat_coil_sizing_ratio",  # Only for ASHP or WSHP
!x!  :default => 1.0, :domain => Numeric
!x!
!x!
!x!#dx_min_temp  Minimum Outdoor Dry-Bulb Temperature for Compressor Operation (C)
!x!
!x!# add these to the rules:
!x!parameter "hp_min_temp", :default => 10.04['F']  # Only for ASHP
!x!parameter "hp_defrost_temp", :default => 35['F']  # Only for ASHP
!x!
!x!
!x!# ASHP only?  or can we call this hp_
!x!parameter "ashp_aux_heat_max_temp", :default => 40['F']
!x!parameter "ashp_supply_max_temp", :default => Autosize  # was 105['F']  # same as sat_max_temp?
!x!
!x!
!x!
!x!parameter "dx_type",  # Used to set performance curves; SPLIT only applies to variable-speed compressor; TERMINAL only applies to constant-speed compressor.
!x!  :default => "PNNL"  # (PACKAGED | SPLIT | TERMINAL)
!x!parameter "dx_comp_speed", :default => "CONSTANT"  # (CONSTANT | DUAL | VARIABLE)
!x!parameter "dx_crankcase_max_temp", :default => 4.4['C']
!x!parameter "dx_crankcase_cap", :default => 50['W']
!x!
!x!#   coil_dx_type
!x!#   coil_dx_comp_speed!!x!#   coil_hp_min_temp   etc.
!x!
!x!parameter "aux_heat_coil_type", :default => "NONE"  # (COMBUSTION | RESISTANCE | NONE)
!x!parameter "aux_heat_coil_cap", :default => Autosize
!x!parameter "aux_heat_coil_eff", :default => 0.8
!x!parameter "aux_heat_coil_fuel", :default => "NaturalGas"  # (NaturalGas | Propane | ...)
!x!
!x!
!x!rule "cool_coil_type_dx_air", :parameters => {:cool_coil_type => "DX-AIR"} do
!x!  default :cool_coil_cop => 3.0
!x!  disable :cool_coil_evap_eff
!x!end
!x!
!x!rule "cool_coil_type_dx_evap", :parameters => {:cool_coil_type => "DX-EVAP"} do
!x!  default :cool_coil_cop => 3.3
!x!  default :cool_coil_evap_eff => 0.9
!x!end
!x!
!x!rule "cool_coil_type_dx_water", :parameters => {:cool_coil_type => "DX-WATER"} do
!x!  default :cool_coil_cop => 3.7
!x!  disable :cool_coil_evap_eff
!x!end
!x!
!x!rule "cool_coil_type_water", :parameters => {:cool_coil_type => "WATER"} do
!x!  disable :cool_coil_cop
!x!  disable :cool_coil_evap_eff
!x!end
!x!
!x!rule "cool_coil_type_none", :parameters => {:cool_coil_type => "NONE"} do
!x!  disable :cool_coil_cop
!x!  disable :cool_coil_evap_eff
!x!  disable :cool_coil_cap
!x!end
!x!
!x!rule "heat_coil_type_combustion", :parameters => {:heat_coil_type => "COMBUSTION"} do
!x!  default :heat_coil_eff => 0.8
!x!  #disable :heat_coil_cop  # do not use temporarily until rule override in import
!x!  default :heat_coil_fuel => "NaturalGas"
!x!end
!x!
!x!rule "heat_coil_type_resistance", :parameters => {:heat_coil_type => "RESISTANCE"} do
!x!  default :heat_coil_eff => 0.98
!x!  disable :heat_coil_cop
!x!  disable :heat_coil_fuel
!x!end
!x!
!x!
!x!rule "heat_coil_type_dx_water", :parameters => {:heat_coil_type => "DX-WATER"} do
!x!  disable :heat_coil_eff
!x!  default :heat_coil_cop => 3.2
!x!  disable :heat_coil_fuel
!x!end
!x!
!x!rule "heat_coil_type_water", :parameters => {:heat_coil_type => "WATER"} do
!x!  disable :heat_coil_eff
!x!  disable :heat_coil_cop
!x!  disable :heat_coil_fuel
!x!end
!x!
!x!rule "heat_coil_type_steam", :parameters => {:heat_coil_type => "STEAM"} do
!x!  disable :heat_coil_eff
!x!  disable :heat_coil_cop
!x!  disable :heat_coil_fuel
!x!end
!x!
!x!rule "heat_coil_type_none", :parameters => {:heat_coil_type => "NONE"} do
!x!  disable :heat_coil_eff
!x!  disable :heat_coil_cop
!x!  disable :heat_coil_fuel
!x!  disable :heat_coil_cap
!x!  force :aux_heat_coil_type => "NONE"
!x!end
!x!
!x!
!x!rule "aux_heat_coil_type_combustion", :parameters => {:aux_heat_coil_type => "COMBUSTION"} do
!x!  default :aux_heat_coil_eff => 0.8
!x!  default :aux_heat_coil_fuel => "NaturalGas"
!x!end
!x!
!x!rule "aux_heat_coil_type_resistance", :parameters => {:aux_heat_coil_type => "RESISTANCE"} do
!x!  default :aux_heat_coil_eff => 1.0
!x!  disable :aux_heat_coil_fuel
!x!end
!x!
!x!rule "aux_heat_coil_type_none", :parameters => {:aux_heat_coil_type => "NONE"} do
!x!  disable :aux_heat_coil_eff
!x!  disable :aux_heat_coil_fuel
!x!  disable :aux_heat_coil_cap
!x!end
!x!
!x!parameter "sat_temp_max", :default => Autosize
!x!#  Autosizing both of these eliminates a warning: this value was not matching the Sizing:System or Sizing:Zone supply temps
!x!
!x!  # interesting these are AHU only
!x!  # what about SAT for ZN-* systems? e.g., PTAC
!x!# UnitarySystem has:
!x!#   Minimum Supply Air Temperature {C}  if DOAS = Yes, this is like a defrost min temp; means something else for SingleZoneVAV
!x!#   Maximum Supply Air Temperature {C}  default 80 C; ~ same as terminal max heating temp; SingleZoneVAV is more specific
!x!
!x!
!x!parameter "clear_water_storage_tank", :default => ""  # Name of tank for collecting cooling coil condensate
!x!
!x!parameter "disable_ems", :default => false, :type => "Enumeration", :valuelist => "true,false"
!x!
!x!%>
!x!
!x!<%
!x!if (control_zone_name.empty?)
!x!  control_type = "Setpoint"
!x!
!x!# TRC - enable variable speed operation for cPVVG system type
!x!elsif ((fan_speed == "VARIABLE") && (heat_coil_type == "WATER" || (heat_coil_type == "DX-AIR" && dx_comp_speed == "CONSTANT")) && (cool_coil_type == "WATER" || (cool_coil_type == "DX-AIR" || dx_comp_speed == "CONSTANT")))
!x!  control_type = "SingleZoneVAV"
!x!else
!x!  control_type = "Load"
!x!end
!x!
!x!if fan_mode_sch == "" and fan_mode == "SCHEDULE"
!x!  fan_mode_sch = op_sch
!x!end
!x!
!x!if (dx_comp_speed == "CONSTANT")
!x!  dx_comp_speed_num = 1
!x!  cool_coil_cd = 0.07
!x!  cool_coil_cop_1 = cool_coil_cop
!x!  if heat_coil_type.include?("DX")
!x!    heat_coil_cd = 0.11
!x!    heat_coil_cop_1 = heat_coil_cop
!x!  end
!x!elsif (dx_comp_speed == "TWO-SPEED")
!x!  dx_comp_speed_num = 2
!x!  cool_coil_cd = 0
!x!  cool_coil_cop_1 = cool_coil_cop * 1.0148883375
!x!  cool_coil_cop_2 = cool_coil_cop 
!x!  if heat_coil_type.include?("DX")
!x!    heat_coil_cd = 0
!x!    heat_coil_cop_1 = heat_coil_cop * 1.0148883375
!x!    heat_coil_cop_2 = heat_coil_cop
!x!  end
!x!elsif (dx_comp_speed == "DUAL")
!x!  dx_comp_speed_num = 2
!x!  cool_coil_cd = 0.11
!x!  cool_coil_cop_1 = cool_coil_cop / 0.9
!x!  cool_coil_cop_2 = cool_coil_cop
!x!  if heat_coil_type.include?("DX")
!x!    heat_coil_cd = 0.11
!x!    heat_coil_cop_1 = heat_coil_cop / 0.9
!x!    heat_coil_cop_2 = heat_coil_cop
!x!  end
!x!elsif (dx_comp_speed == "DUAL-EQUAL")
!x!  dx_comp_speed_num = 2
!x!  cool_coil_cd = 0.25
!x!  cool_coil_cop_1 = cool_coil_cop
!x!  cool_coil_cop_2 = cool_coil_cop
!x!  if heat_coil_type.include?("DX")
!x!    heat_coil_cd = 0.11
!x!    heat_coil_cop_1 = heat_coil_cop / 0.9
!x!    heat_coil_cop_2 = heat_coil_cop
!x!  end
!x!elsif (dx_comp_speed == "VARIABLE")
!x!  dx_comp_speed_num = 4
!x!  cool_coil_cd = 0.25
!x!  cool_coil_cop_1 = cool_coil_cop / 0.7
!x!  cool_coil_cop_2 = cool_coil_cop / 0.75
!x!  cool_coil_cop_3 = cool_coil_cop / 0.9
!x!  cool_coil_cop_4 = cool_coil_cop
!x!  if heat_coil_type.include?("DX")
!x!    heat_coil_cd = 0.24
!x!    heat_coil_cop_1 = heat_coil_cop / 0.7
!x!    heat_coil_cop_2 = heat_coil_cop / 0.75
!x!    heat_coil_cop_3 = heat_coil_cop / 0.9
!x!    heat_coil_cop_4 = heat_coil_cop
!x!  end
!x!end
!x!
!x!%>
!x!<% # NOTE: No need to include availability schedule on UnitarySystem -- fan schedules can be specified in the fan objects, and PNNL models all have continuous availability for unitarysystems
!x!# Need continuous availability for night cycle to work properly
!x!%>
!x!
!x!<% if (fan_type == "ON-OFF") 
!x!  iv_sup_fan_obj = "Fan:OnOff"
!x!elsif (fan_type == "SYSTEM-MODEL")
!x!  iv_sup_fan_obj = "Fan:SystemModel"
!x!elsif (fan_type == "VAV") 
!x!  iv_sup_fan_obj = "Fan:VariableVolume"
!x!end %>
!x!
!x!<% if (fan_config == "DRAW-THROUGH")
!x!  iv_fan_placement = "DrawThrough"
!x!elsif (fan_config == "BLOW-THROUGH")
!x!  iv_fan_placement = "BlowThrough"
!x!else
!x!  iv_fan_placement = "BlowThrough"
!x!end %>

!x!<% if (heat_coil_type == "COMBUSTION")
!x!  iv_heat_coil_obj = "Coil:Heating:Fuel"
!x!  iv_heat_coil_nm = unitary_name + " Heating Coil"
!x!  iv_dx_heat_coil_szratio = ""
!x!elsif (heat_coil_type == "RESISTANCE")
!x!  iv_heat_coil_obj = "Coil:Heating:Electric"
!x!  iv_heat_coil_nm = unitary_name + " Heating Coil"
!x!  iv_dx_heat_coil_szratio = ""
!x!elsif (heat_coil_type == "DX-AIR")
!x! if (dx_comp_speed_num == 1)
!x!  iv_heat_coil_obj = "Coil:Heating:DX:SingleSpeed"
!x!  iv_heat_coil_nm = unitary_name + " Heating Coil"
!x!  iv_dx_heat_coil_szratio = heat_coil_sizing_ratio
!x! elsif (dx_comp_speed_num > 1)
!x!  iv_heat_coil_obj = "Coil:Heating:DX:MultiSpeed"
!x!  iv_heat_coil_nm = unitary_name + " Heating Coil"
!x!  iv_dx_heat_coil_szratio = heat_coil_sizing_ratio
!x! end
!x!elsif (heat_coil_type == "DX-WATER")
!x!  if dx_comp_speed_num == 1
!x!   iv_heat_coil_obj = "Coil:Heating:WaterToAirHeatPump:EquationFit"
!x!  elsif dx_comp_speed_num > 1
!x!   iv_heat_coil_obj = "Coil:Heating:WaterToAirHeatPump:VariableSpeedEquationFit"
!x!  end
!x!  iv_heat_coil_nm = unitary_name + " Heating Coil"
!x!  iv_dx_heat_coil_szratio = heat_coil_sizing_ratio
!x!elsif (heat_coil_type == "WATER")
!x!  iv_heat_coil_obj = "Coil:Heating:Water"
!x!  iv_heat_coil_nm = unitary_name + " Heating Coil"
!x!  iv_dx_heat_coil_szratio = ""
!x!elsif (heat_coil_type == "STEAM")
!x!  iv_heat_coil_obj = "Coil:Heating:Steam"
!x!  iv_heat_coil_nm = unitary_name + " Heating Coil"
!x!  iv_dx_heat_coil_szratio = ""
!x!elsif (heat_coil_type == "NONE")
!x!  iv_heat_coil_obj = ""
!x!  iv_heat_coil_nm = ""
!x!  iv_dx_heat_coil_szratio = ""
!x!elsif (heat_coil_type == "MULTI-STAGE-GAS")
!x!  iv_heat_coil_obj = "Coil:Heating:Gas:MultiStage"
!x!  iv_heat_coil_nm = unitary_name + " Heating Coil"
!x!  iv_dx_heat_coil_szratio = ""
!x!end %>
!x! <% # Added for steam boiler variant. Behzad Rizi 2024-01-08 %>
!x!
!x!<% if (cool_coil_type == "DX-AIR")
!x! if (dx_comp_speed_num == 1)
!x!  iv_cool_coil_obj = "Coil:Cooling:DX:SingleSpeed"
!x! elsif (dx_comp_speed_num > 1)
!x!  iv_cool_coil_obj = "Coil:Cooling:DX:MultiSpeed"
!x! end
!x!  iv_cool_coil_nm = unitary_name + " Cooling Coil"
!x!elsif (cool_coil_type == "DX-WATER")
!x!  if (dx_comp_speed_num == 1)
!x!    iv_cool_coil_obj = "Coil:Cooling:WaterToAirHeatPump:EquationFit"
!x!  elsif (dx_comp_speed_num > 1)
!x!   iv_cool_coil_obj = "Coil:Cooling:WaterToAirHeatPump:VariableSpeedEquationFit"
!x!  end
!x!  iv_cool_coil_nm = unitary_name + " Cooling Coil"
!x!elsif (cool_coil_type == "WATER")
!x!  iv_cool_coil_obj = "Coil:Cooling:Water"
!x!  iv_cool_coil_nm = unitary_name + " Cooling Coil"
!x!elsif (cool_coil_type == "NONE")
!x!  iv_cool_coil_obj = ""
!x!  iv_cool_coil_nm = ""
!x!end %>
!x!
!x!<% if (doas && cool_coil_type.include?("DX"))
!x!  iv_use_doas_dx_cool = "Yes"
!x!else
!x!  iv_use_doas_dx_cool = "No"
!x!end %>
!x!
!x!<% if (aux_heat_coil_type == "COMBUSTION")
!x!  iv_sup_heat_coil_obj = "Coil:Heating:Fuel"
!x!  iv_sup_heat_coil_nm = unitary_name + " Aux Heating Coil"
!x!elsif (aux_heat_coil_type == "RESISTANCE")
!x!  iv_sup_heat_coil_obj = "Coil:Heating:Electric"
!x!  iv_sup_heat_coil_nm = unitary_name + " Aux Heating Coil"
!x!elsif (aux_heat_coil_type == "NONE")
!x!  iv_sup_heat_coil_obj = ""
!x!  iv_sup_heat_coil_nm = ""
!x!end %>
!x!
!x!<%# TRC - add option to set no load fraction of supply air flow rate for cPVVG system type
!x!    #0.67 is the EnergyPlus default for SupplyAirFlowRate method %>
!x!
!x!<% if (unitary_no_load_flow_method == "FractionOfAutosizedCoolingValue")
!x!  if (cool_flow_min_frac) 
!x!   iv_noload_frac_cool_supply = cool_flow_min_frac
!x!  else ("0.67") 
!x!   iv_noload_frac_cool_supply = 0.67
!x!  end
!x!else
!x!  iv_noload_frac_cool_supply = ""
!x!end %>
!x!
!x!<% if (heat_coil_type == "DX-AIR")
!x!  iv_max_supply_air_temp = ashp_supply_max_temp
!x!else
!x!  iv_max_supply_air_temp = sat_temp_max
!x!end %>
!x!
!x!<% if (aux_heat_coil_type == "NONE")
!x!  iv_max_oa_db_temp_supp = ""
!x!else
!x!  iv_max_oa_db_temp_supp = ashp_aux_heat_max_temp
!x!end %>
!x!
!x!<% if (cool_coil_type == "DX-AIR" and dx_comp_speed_num > 1)
!x!  iv_des_spec_ms_hp_obj = "UnitarySystemPerformance:Multispeed"
!x!  iv_des_spec_ms_hp_nm = unitary_name + " Multispeed Performance"
!x!else
!x!  iv_des_spec_ms_hp_obj = ""
!x!  iv_des_spec_ms_hp_nm = ""
!x!end %>

